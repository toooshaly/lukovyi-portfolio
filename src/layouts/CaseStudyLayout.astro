---
/**
 * CaseStudyLayout — сторінка кейсу у брутально-мінімалістичному стилі.
 */
import { Image } from "astro:assets";
import BaseLayout from "./BaseLayout.astro";
import { SITE } from "../consts";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"projects">;
}
const { entry } = Astro.props;
const d = entry.data;

const title = d.seoTitle ?? `${d.title} — ${d.category} | ${SITE.name}`;
const description = d.seoDescription ?? d.summary;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

const caseSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: d.title,
  about: d.category,
  abstract: d.summary,
  url: canonicalURL,
  creator: { "@id": `${SITE.url}/#person` },
  ...(d.year ? { dateCreated: d.year } : {}),
};

const meta = [
  { k: "Role", v: d.role },
  { k: "Timeline", v: d.timeline },
  { k: "Year", v: d.year },
  { k: "Client", v: d.client },
].filter((m) => m.v && !String(m.v).startsWith("TODO"));
---

<BaseLayout title={title} description={description} ogType="article" jsonLd={caseSchema}>
  <article>
    <!-- Шапка -->
    <section class="wrap">
      <a href="/projects" class="mono back">[ &lt; Work ]</a>
      <div class="mono cat">{d.category}{d.status ? <span class="tag"> · {d.status}</span> : null}</div>
      <h1 class="case-h">{d.title}</h1>
      <p class="summary">{d.summary}</p>
      {meta.length > 0 && (
        <dl class="meta mono">
          {meta.map((m) => (
            <div><dt>{m.k}</dt><dd>{m.v}</dd></div>
          ))}
        </dl>
      )}
    </section>

    <!-- Обкладинка -->
    {d.cover && (
      <section class="wrap">
        <Image src={d.cover} alt={`${d.title} — cover`} widths={[640, 1024, 1600]} sizes="(max-width: 1200px) 100vw, 1200px" class="cover" />
      </section>
    )}

    <!-- Метрики -->
    {d.metrics && d.metrics.length > 0 && (
      <section class="wrap">
        <div class="metrics">
          {d.metrics.map((m) => (
            <div class="metric">
              <div class="metric-v">{m.value}</div>
              <div class="mono metric-l">{m.label}</div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Контент -->
    <section class="wrap">
      <div class="case-content"><slot /></div>
    </section>

    <!-- CTA -->
    <section class="wrap">
      <div class="cta">
        <span class="mono idx">[ Next ]</span>
        <a href="/contact" class="cta-h">Like what you see?<br />Let's build something. <span class="sl">&gt;</span></a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .sl { color: var(--color-accent); }
  .back { color: var(--color-accent); display: inline-block; margin-bottom: 2rem; }
  .cat { color: var(--color-faint); }
  .tag { color: var(--color-accent); }
  .case-h { margin-top: 0.75rem; font-size: clamp(2.5rem, 9vw, 6rem); font-weight: 700; line-height: 0.9; letter-spacing: -0.04em; text-transform: uppercase; }
  .summary { margin-top: 1.5rem; max-width: 40ch; font-size: clamp(1.25rem, 2.6vw, 1.9rem); line-height: 1.25; letter-spacing: -0.02em; color: var(--color-mute); }
  .meta { margin-top: 2.5rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; border-top: 1px solid var(--color-line); padding-top: 1.5rem; }
  .meta dt { color: var(--color-faint); }
  .meta dd { color: var(--color-ink); margin-top: 0.2rem; }
  @media (min-width: 720px) { .meta { grid-template-columns: repeat(4, 1fr); } }

  .cover { width: 100%; border: 1px solid var(--color-line); }
  .metrics { display: grid; grid-template-columns: 1fr; gap: 2rem; border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); padding: 2.5rem 0; }
  .metric-v { font-size: clamp(2.5rem, 7vw, 5rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--color-accent); }
  .metric-l { color: var(--color-mute); margin-top: 0.5rem; }
  @media (min-width: 720px) { .metrics { grid-template-columns: repeat(3, 1fr); } }

  .cta { border-top: 1px solid var(--color-line); padding-top: 2rem; }
  .idx { color: var(--color-faint); display: block; margin-bottom: 1rem; }
  .cta-h { font-size: clamp(1.75rem, 5vw, 3.5rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1; text-transform: uppercase; }
  .cta-h:hover { color: var(--color-accent); }
</style>

<style is:global>
  .case-content { max-width: 720px; }
  .case-content > * + * { margin-top: 1.25rem; }
  .case-content h2 { margin-top: 3rem; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; letter-spacing: -0.02em; text-transform: uppercase; color: var(--color-ink); }
  .case-content h3 { margin-top: 2rem; font-size: 1.3rem; font-weight: 500; color: var(--color-ink); }
  .case-content h4 { margin-top: 2rem; font-size: 1.05rem; font-weight: 700; color: var(--color-ink); }
  .case-content p, .case-content li { color: var(--color-mute); line-height: 1.7; font-size: 1.05rem; }
  .case-content strong { color: var(--color-ink); font-weight: 700; }
  .case-content ul { list-style: none; padding-left: 0; }
  .case-content ul li { padding-left: 1.25rem; position: relative; }
  .case-content ul li::before { content: "/"; position: absolute; left: 0; color: var(--color-accent); }
  .case-content a { color: var(--color-accent); text-decoration: underline; text-underline-offset: 2px; }
  .case-content img { display: block; width: 100%; margin: 2rem 0; border: 1px solid var(--color-line); }
  .case-content blockquote { margin: 2rem 0; padding: 1.25rem 1.5rem; border-left: 3px solid var(--color-accent); background: #ececec; }
  .case-content blockquote p { color: var(--color-ink); font-size: 1.2rem; }
  .case-content table { width: 100%; border-collapse: collapse; margin: 2rem 0; font-family: var(--font-mono); font-size: 0.85rem; }
  .case-content th, .case-content td { padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--color-line); text-align: right; }
  .case-content th:first-child, .case-content td:first-child { text-align: left; }
  .case-content th { color: var(--color-faint); text-transform: uppercase; font-weight: 400; }
  .case-content thead th { border-bottom-color: var(--color-ink); }
</style>
