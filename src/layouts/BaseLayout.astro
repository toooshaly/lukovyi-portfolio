---
/**
 * BaseLayout — брутально-мінімалістичний каркас (референс: gustaffurusten.se).
 * Тонкий верхній бар + контент + футер із живим таймстемпом. SEO у head.
 */
import "../styles/global.css";
import { SITE, SOCIALS } from "../consts";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = SITE.description,
  canonical,
  ogType = "website",
  jsonLd,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL("/og-default.png", Astro.site).href;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const nav = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/projects" },
  { label: "Lab", href: "/projects" },
  { label: "About", href: "/about-me" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  address: { "@type": "PostalAddress", addressLocality: SITE.location },
  sameAs: SOCIALS.map((s) => s.href),
};
const schemas = [personSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preload" href="/fonts/SpaceGrotesk-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f4f4f4" />
    <meta name="generator" content={Astro.generator} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>

  <body class="min-h-screen flex flex-col">
    <!-- Центроване нав-меню (пігулка) -->
    <header class="topbar">
      <nav class="pill mono">
        {nav.map((n) => (
          <a href={n.href} class:list={["nav-link", isActive(n.href) && "is-active"]}>{n.label}</a>
        ))}
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Футер -->
    <footer class="footer mono">
      <div class="foot-mark" aria-hidden="true">S<span class="sl">]</span> P</div>
      <div class="foot-cols">
        <div class="foot-c">
          <div class="foot-h">▸ Contact</div>
          <a href={`mailto:${SITE.email}`} class="foot-a">{SITE.email}</a>
          {SOCIALS.slice(0, 2).map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="foot-a">{s.label} ↗</a>
          ))}
        </div>
        <div class="foot-c">
          <div class="foot-h">▸ Menu</div>
          <a href="/projects" class="foot-a">Work</a>
          <a href="/about-me" class="foot-a">About</a>
          <a href="/contact" class="foot-a">Contact</a>
        </div>
        <div class="foot-c foot-clock">
          <div class="foot-a">TIME: <span id="footTime">--:--:--</span></div>
          <div class="foot-a">DATE: <span id="footDate">—</span></div>
          <div class="foot-a">{SITE.location}</div>
        </div>
      </div>
      <div class="foot-bottom">© {year} {SITE.name} — all rights reserved</div>
    </footer>

    <style>
      .topbar { position: sticky; top: 0; z-index: 40; display: flex; justify-content: center; padding: 0.75rem 1rem; pointer-events: none; }
      .pill { pointer-events: auto; display: flex; gap: 0.35rem; padding: 0.35rem; border-radius: 999px; background: color-mix(in srgb, var(--color-paper) 78%, transparent); backdrop-filter: blur(10px); border: 1px solid var(--color-line); }
      .nav-link { padding: 0.35rem 0.9rem; border-radius: 999px; color: var(--color-mute); transition: color .15s, background .15s; }
      .nav-link:hover { color: var(--color-ink); }
      .nav-link.is-active { color: var(--color-ink); background: color-mix(in srgb, var(--color-ink) 8%, transparent); }

      .footer { margin-top: 7rem; border-top: 1px solid var(--color-line); padding: 3rem 1.5rem 1.5rem; }
      .foot-mark { font-family: var(--font-sans); font-weight: 700; font-size: clamp(4rem, 14vw, 10rem); line-height: 0.8; letter-spacing: -0.05em; color: var(--color-ink); text-transform: uppercase; }
      .sl { color: var(--color-accent); }
      .foot-cols { display: grid; grid-template-columns: 1fr; gap: 1.5rem; max-width: 1200px; margin: 2.5rem auto 0; }
      .foot-h { color: var(--color-faint); margin-bottom: 0.75rem; }
      .foot-a { display: block; color: var(--color-ink); padding: 2px 0; }
      a.foot-a:hover { color: var(--color-accent); }
      .foot-bottom { max-width: 1200px; margin: 2.5rem auto 0; padding-top: 1.25rem; border-top: 1px solid var(--color-line); color: var(--color-mute); }
      @media (min-width: 720px) { .foot-cols { grid-template-columns: repeat(3, 1fr); } .foot-clock { text-align: right; } }
    </style>

    <script>
      function tickFoot() {
        const now = new Date();
        const p = (n: number) => String(n).padStart(2, "0");
        const t = document.getElementById("footTime");
        const d = document.getElementById("footDate");
        if (t) t.textContent = `${p(now.getHours())}:${p(now.getMinutes())}:${p(now.getSeconds())}`;
        if (d) d.textContent = now.toLocaleDateString("en-GB", { day: "2-digit", month: "2-digit", year: "numeric" });
      }
      tickFoot();
      const w = window as any;
      if (!w.__footClock) w.__footClock = setInterval(tickFoot, 1000);
      document.addEventListener("astro:page-load", tickFoot);
    </script>
  </body>
</html>
