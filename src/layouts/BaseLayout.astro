---
/**
 * BaseLayout — шарова оболонка сайту 1:1 з Figma "Portfolio 2.0".
 * Навбар: логотип · центральна glass-пігулка (HOME/WORK/LAB/ABOUT) · перемикач
 * теми · ім'я/роль. Футер: CONTACT · координати+годинник · DESLUK · legal.
 * Тема (light/dark) керується [data-theme] на <html> з no-FOUC інлайн-скриптом.
 */
import "../styles/global.css";
import { Image } from "astro:assets";
import { SITE, SOCIALS } from "../consts";
import logoSvg from "../assets/icons/logo.svg?raw";
import SectionMarker from "../components/SectionMarker.astro";
import deslukBlack from "../assets/footer/desluk-black.png"; // чорний DESLUK — світла тема
import deslukWhite from "../assets/footer/desluk-white.png"; // білий DESLUK — темна тема

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = SITE.description,
  canonical,
  ogType = "website",
  jsonLd,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL("/og-default.png", Astro.site).href;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const nav = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work" },
  { label: "About", href: "/about-me" },
];
const isActive = (href: string) =>
  href === "/"
    ? path === "/"
    : href === "/work"
      ? path === "/work" || path.startsWith("/projects")
      : path === href || path.startsWith(href + "/");

const linkedin = SOCIALS.find((s) => s.label === "LinkedIn");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  address: { "@type": "PostalAddress", addressLocality: SITE.location },
  sameAs: SOCIALS.map((s) => s.href),
};
const schemas = [personSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preload" href="/fonts/Monoska-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Якщо прийшли через перехід — накрити завісою ДО першого кадру (без спалаху контенту).
      try { if (sessionStorage.getItem("pt-cover")) document.documentElement.classList.add("pt-arriving"); } catch (e) {}
    </script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {/* No-FOUC: застосувати збережену тему до першого малювання */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <!-- ПЕРЕХІД МІЖ СТОРІНКАМИ — «жалюзі» (8 слатів). Стартово закриті,
         на завантаженні розкриваються з центру до боків; на кліку по
         внутрішньому посиланні закриваються з боків до центру → навігація. -->
    <div id="pagecover" aria-hidden="true">{Array.from({ length: 12 }).map((_, i) => <span class="pc-col" style={`--i:${i}`} />)}</div>

    <!-- Прогресивний blur по верхньому й нижньому краю (ефект при скролі).
         3 шари з наростаючим блюром + градієнтна маска = плавний перехід. -->
    <div class="edge-blur edge-blur--top" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="edge-blur edge-blur--bottom" aria-hidden="true"><i></i><i></i><i></i></div>

    <!-- НАВБАР -->
    <header class="nav">
      <div class="nav-center">
        <nav class="nav-pill glass" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} class:list={["nav-link", "link-fx", isActive(n.href) && "is-active"]}><span class="nl-t">{n.label}</span></a>
          ))}
        </nav>
        <button id="themeToggle" class="theme-toggle glass" type="button" aria-label="Toggle color theme">
          <svg class="ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.6 4.6l1.7 1.7M17.7 17.7l1.7 1.7M19.4 4.6l-1.7 1.7M6.3 17.7l-1.7 1.7" />
          </svg>
          <svg class="ico-moon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ФУТЕР -->
    <footer class="footer">
      <div class="foot-card">
        <div class="foot-top">
          <div class="foot-contact">
            <SectionMarker label="Contact" style="margin-bottom:20px" />
            <dl class="foot-dl label">
              <div class="foot-row"><dt>Mail</dt><dd><a class="link-fx" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
              {linkedin && (
                <div class="foot-row"><dt>LinkedIn</dt><dd><a class="link-fx" href={linkedin.href} target="_blank" rel="noopener noreferrer">Anton_Lukovyi ↗</a></dd></div>
              )}
            </dl>
          </div>
          <div class="foot-geo label">
            <span>52.62.10.00E — {SITE.location}</span>
            <span class="foot-clock" data-clock>--:--:--</span>
          </div>
        </div>

        <div class="foot-mark">
          <Image src={deslukBlack} alt="DESLUK" class="fm-img fm-light" widths={[720, 1320, 2200]} sizes="(max-width: 720px) 90vw, 92vw" loading="lazy" />
          <Image src={deslukWhite} alt="" aria-hidden="true" class="fm-img fm-dark" widths={[720, 1320, 2200]} sizes="(max-width: 720px) 90vw, 92vw" loading="lazy" />
        </div>

        <div class="foot-bottom">
          <hr class="rule" />
          <div class="foot-legal label">
            <span>© {year} {SITE.name}. All rights reserved.</span>
            <span class="foot-legal-links">
              <a class="link-fx" href="/privacy">Privacy Policy</a>
              <a class="link-fx" href="/terms">Terms &amp; Conditions</a>
            </span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Логотип і бічний підпис — окремі fixed-елементи поверх контенту,
         щоб інвертувались (mix-blend) проти фону сторінки, не чіпаючи центр. -->
    <a href="/" class="nav-logo" aria-label={`${SITE.name} — home`} set:html={logoSvg} />
    <div class="nav-id label">
      <span>{SITE.name}</span>
      <span class="nav-role">UX/UI/Product Designer</span>
    </div>

    <style is:global>
      /* Перемикання теми «хвилею»: нова тема відкривається круговим clip-path
         від кнопки (див. скрипт), стара лишається під нею. Вимикаємо дефолтний кросфейд. */
      ::view-transition-old(root),
      ::view-transition-new(root) { animation: none; mix-blend-mode: normal; }
      ::view-transition-new(root) { z-index: 9999; }
      ::view-transition-old(root) { z-index: 1; }
    </style>

    <style>
      /* ---------- Прогресивний BLUR по краях (на скролі) ---------- */
      .edge-blur {
        position: fixed; left: 0; right: 0; height: var(--blur-height); z-index: 30;
        pointer-events: none; overflow: hidden;
        opacity: 1; transition: opacity .35s ease;
      }
      /* вимикається залежно від позиції скролу (див. скрипт нижче) */
      .edge-blur.is-off { opacity: 0; }
      /* Без підфарбування — тільки чистий blur. Однаково на світлій і темній
         темі (не залежить від теми, нічого не перемикається). */
      .edge-blur--top { top: 0; }
      .edge-blur--bottom { bottom: 0; }
      .edge-blur > i { position: absolute; inset: 0; display: block; }

      /* три шари: слабкий по всій смузі → найсильніший біля самого краю */
      .edge-blur--top > i:nth-child(1) { backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
        mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%); }
      .edge-blur--top > i:nth-child(2) { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 22%, transparent 62%);
        mask-image: linear-gradient(to bottom, #000 0%, #000 22%, transparent 62%); }
      .edge-blur--top > i:nth-child(3) { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 38%);
        mask-image: linear-gradient(to bottom, #000 0%, transparent 38%); }

      .edge-blur--bottom > i:nth-child(1) { backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
        -webkit-mask-image: linear-gradient(to top, #000 0%, #000 45%, transparent 100%);
        mask-image: linear-gradient(to top, #000 0%, #000 45%, transparent 100%); }
      .edge-blur--bottom > i:nth-child(2) { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        -webkit-mask-image: linear-gradient(to top, #000 0%, #000 22%, transparent 62%);
        mask-image: linear-gradient(to top, #000 0%, #000 22%, transparent 62%); }
      .edge-blur--bottom > i:nth-child(3) { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 38%);
        mask-image: linear-gradient(to top, #000 0%, transparent 38%); }

      @media (max-width: 720px) { .edge-blur { height: 92px; } }
      @media (prefers-reduced-motion: reduce) { .edge-blur { display: none; } }

      /* Приємний плавний скрол для якорів (напр. Work → секція робіт) */
      @media (prefers-reduced-motion: no-preference) { :global(html) { scroll-behavior: smooth; } }

      /* Lenis — плавний моментум-скрол сторінки */
      :global(html.lenis), :global(html.lenis body) { height: auto; }
      :global(.lenis.lenis-smooth) { scroll-behavior: auto !important; }
      :global(.lenis.lenis-smooth [data-lenis-prevent]) { overscroll-behavior: contain; }
      :global(.lenis.lenis-stopped) { overflow: hidden; }

      /* Ховаємо системний скролбар сторінки (скрол лишається робочим) */
      :global(html) { scrollbar-width: none; -ms-overflow-style: none; }
      :global(html::-webkit-scrollbar) { width: 0; height: 0; display: none; }

      /* Sticky-footer: на коротких сторінках футер притискається донизу,
         тож нижній відступ (24px у .footer) однаковий на всіх сторінках. */
      :global(body) { min-height: 100vh; min-height: 100dvh; display: flex; flex-direction: column; }
      :global(main) { flex: 1 0 auto; }

      /* ---------- НАВБАР ---------- */
      .nav {
        position: sticky; top: 0; z-index: 50;
        display: flex; justify-content: center; align-items: center;
        gap: 1rem; padding: var(--nav-pad-y) var(--pad-side);
        /* Контрастний чип під центральні кнопки (видимість + акцент активного).
           Лого й бічний текст — окремі fixed-елементи з інверсією (нижче). */
        --nav-chip: rgba(255, 255, 255, 0.72);
      }
      :root[data-theme="dark"] .nav { --nav-chip: rgba(0, 0, 0, 0.55); }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .nav { --nav-chip: rgba(0, 0, 0, 0.55); }
      }
      /* Лого — fixed поверх контенту, інвертується проти фону сторінки */
      .nav-logo {
        position: fixed; top: var(--nav-pad-y); left: var(--pad-side); z-index: 60;
        color: #fff; width: 46px; height: 48px; mix-blend-mode: difference;
      }
      .nav-logo :global(svg) { width: 100%; height: 100%; }

      .nav-center { display: flex; justify-content: center; align-items: center; gap: 10px; }
      .nav-pill { display: flex; gap: 2px; padding: 4px; border-radius: 999px; background: var(--nav-chip); }
      .nav-link {
        font-family: var(--font-display); font-size: var(--size-sm); text-transform: uppercase;
        padding: 8px 16px; border-radius: 999px;
      }
      /* текст авто-контрастить проти чипа (difference); opacity — НА ТОМУ Ж елементі,
         що й блендінг, інакше батьківська прозорість ізолює блендінг від фону. */
      .nl-t { color: #fff; mix-blend-mode: difference; display: inline-block; opacity: .9; transition: opacity .15s; }
      .nav-link:hover .nl-t { opacity: 1; }
      /* підкреслення — на лінку, без бленду */
      .nav-link.link-fx::after { left: 16px; right: 16px; bottom: 5px; }
      /* Активний — акцентним кольором (без інверсії, щоб колір був правдивий) */
      .nav-link.is-active .nl-t { opacity: 1; color: var(--text-accent); mix-blend-mode: normal; }

      .theme-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 44px; height: 44px; border-radius: 999px; cursor: pointer;
        color: #fff; padding: 0; background: var(--nav-chip);
      }
      .theme-toggle :global(svg) { mix-blend-mode: difference; }
      .theme-toggle:hover { opacity: .7; }
      /* показуємо іконку відповідно до активної теми */
      .ico-sun { display: none; }
      .ico-moon { display: block; }
      :root[data-theme="dark"] .ico-sun { display: block; }
      :root[data-theme="dark"] .ico-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .ico-sun { display: block; }
        :root:not([data-theme="light"]) .ico-moon { display: none; }
      }

      /* Бічний підпис — fixed поверх контенту, інвертується проти фону */
      .nav-id {
        position: fixed; top: var(--nav-pad-y); right: var(--pad-side); z-index: 60;
        text-align: right; color: #fff; mix-blend-mode: difference;
        display: flex; flex-direction: column; line-height: 1.35;
      }
      .nav-role { opacity: .7; }

      @media (max-width: 720px) {
        .nav { gap: 8px; padding: 12px 16px; }
        .nav-logo { top: 12px; left: 16px; }
        .nav-id { display: none; }
        .nav-center { justify-content: flex-end; }
        .nav-link { padding: 7px 11px; }
        .nav-pill { gap: 0; }
      }

      /* ---------- ФУТЕР (картка, 1:1 з Figma-компонентом) ---------- */
      .footer { margin-top: 24px; padding: 0 0 24px; }
      /* картка: surface/raised + border/subtle + radius, з полями по краях;
         розтягується з в'юпортом. Кольори з токенів → однаково в чорній/білій темі.
         Розміри — з панелі керування (controls.css). */
      .foot-card {
        margin-inline: var(--footer-margin); padding: var(--footer-pad);
        background: var(--surface-raised);
        border: 1px solid var(--border-subtle);
        border-radius: var(--footer-radius);
      }
      /* верхній рядок має роздільник знизу (border-bottom) + відступ під ним */
      .foot-top { display: grid; grid-template-columns: 1fr auto; gap: 2rem; padding-bottom: var(--footer-gap); border-bottom: 1px solid var(--border-subtle); }
      .foot-dl { display: grid; gap: 8px; margin: 0; }
      .foot-row { display: grid; grid-template-columns: 120px 1fr; gap: 12px; }
      .foot-row dt { color: var(--text-muted); }
      .foot-row dd { margin: 0; color: var(--text-primary); }
      .foot-row a:hover { color: var(--text-accent); }
      .foot-geo { display: flex; flex-direction: column; align-items: flex-end; gap: 20px; color: var(--text-muted); text-align: right; }

      /* DESLUK — картинка з Figma (4x). Дві версії: чорна (світла тема) /
         біла (темна тема), перемикаються так само, як іконки теми. */
      .foot-mark { margin-top: var(--footer-gap); }
      .fm-img { width: 100%; height: auto; display: block; }
      .fm-dark { display: none; }
      :root[data-theme="dark"] .fm-light { display: none; }
      :root[data-theme="dark"] .fm-dark { display: block; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .fm-light { display: none; }
        :root:not([data-theme="light"]) .fm-dark { display: block; }
      }

      .foot-bottom { margin-top: var(--footer-gap); }
      .foot-legal { display: flex; justify-content: space-between; gap: 1rem; margin-top: var(--footer-gap); color: var(--text-muted); }
      .foot-legal-links { display: inline-flex; gap: 40px; }
      .foot-legal a:hover { color: var(--text-accent); }

      @media (max-width: 720px) {
        .foot-card { margin-inline: 16px; padding: 20px; }
      }

      @media (max-width: 640px) {
        .foot-top { grid-template-columns: 1fr; }
        .foot-geo { align-items: flex-start; text-align: left; }
        .foot-row { grid-template-columns: 88px 1fr; }
        .foot-legal { flex-direction: column; gap: 12px; }
        .foot-legal-links { gap: 24px; }
      }
    </style>

    <!-- Живий годинник у футері -->
    <script>
      function tickClock() {
        const els = document.querySelectorAll("[data-clock]");
        if (!els.length) return;
        const p = (n: number) => String(n).padStart(2, "0");
        const now = new Date();
        const t = `${p(now.getHours())}:${p(now.getMinutes())}:${p(now.getSeconds())}`;
        els.forEach((el) => (el.textContent = t));
      }
      tickClock();
      const w = window as any;
      if (!w.__clock) w.__clock = setInterval(tickClock, 1000);
      document.addEventListener("astro:page-load", tickClock);
    </script>

    <!-- Edge-blur залежно від скролу: вгорі — ховаємо нижній, внизу — верхній -->
    <script>
      const wb = window as any;
      if (!wb.__edgeBlur) {
        wb.__edgeBlur = true;
        let ticking = false;
        function updateBlur() {
          ticking = false;
          const top = document.querySelector(".edge-blur--top");
          const bot = document.querySelector(".edge-blur--bottom");
          if (!top || !bot) return;
          const y = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const nearTop = y <= 8;
          const nearBottom = y >= max - 8;
          // верхній blur зникає біля нижньої межі;
          // нижній blur зникає біля обох меж (щоб і футер знизу було чітко видно)
          top.classList.toggle("is-off", nearBottom);
          bot.classList.toggle("is-off", nearTop || nearBottom);
        }
        function onScroll() {
          if (!ticking) { ticking = true; requestAnimationFrame(updateBlur); }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        document.addEventListener("astro:page-load", updateBlur);
        updateBlur();
      }
    </script>

    <!-- Перемикач теми (делегування, біндиться один раз) -->
    <script>
      const w = window as any;
      if (!w.__themeBound) {
        w.__themeBound = true;
        document.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest("#themeToggle") as HTMLElement | null;
          if (!btn) return;
          const root = document.documentElement;
          const cur =
            root.getAttribute("data-theme") ||
            (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          const next = cur === "dark" ? "light" : "dark";
          const apply = () => {
            root.setAttribute("data-theme", next);
            try { localStorage.setItem("theme", next); } catch (err) {}
          };
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!(document as any).startViewTransition || reduce) { apply(); return; }
          // Хвиля-reveal нової теми колом від центру кнопки до країв екрана
          const r = btn.getBoundingClientRect();
          const x = r.left + r.width / 2;
          const y = r.top + r.height / 2;
          const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
          const vt = (document as any).startViewTransition(apply);
          vt.ready.then(() => {
            root.animate(
              { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
              { duration: 650, easing: "cubic-bezier(.4,0,.2,1)", pseudoElement: "::view-transition-new(root)" }
            );
          });
        });
      }
    </script>

    <script>
      // Lenis — плавний (моментум) скрол сторінки. Вимикається при reduced-motion.
      import Lenis from "lenis";
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lenis = new Lenis({ duration: 1.1, easing: (t: number) => 1 - Math.pow(1 - t, 3), smoothWheel: true });
        (window as any).lenis = lenis; // доступ для скролу з інших скриптів (напр. перемикач /work)
        const raf = (time: number) => { lenis.raf(time); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
        // Якорі на цій же сторінці (напр. Work → #work) — плавно через Lenis
        document.addEventListener("click", (e) => {
          const a = (e.target as HTMLElement).closest('a[href*="#"]') as HTMLAnchorElement | null;
          if (!a) return;
          const url = new URL(a.href, location.href);
          if (url.pathname !== location.pathname || !url.hash) return;
          const target = document.querySelector(url.hash);
          if (target) { e.preventDefault(); lenis.scrollTo(target as HTMLElement); history.pushState(null, "", url.hash); }
        });
        // Прийшли з іншої сторінки з хешем (напр. /#work) — доскролити до секції
        if (location.hash) {
          const t = document.querySelector(location.hash);
          if (t) requestAnimationFrame(() => lenis.scrollTo(t as HTMLElement, { immediate: true }));
        }
      }
    </script>

    <script>
      // Scramble/дешифрування всіх заголовків, коли вони з'являються у полі зору.
      // Спрацьовує щоразу при вході елемента у в'юпорт; зберігає структуру (spans, br).
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#*_—";
        const rnd = () => chars[(Math.random() * chars.length) | 0];
        const animating = new WeakSet();
        function scramble(el, dur) {
          if (animating.has(el)) return;
          animating.add(el);
          const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
            acceptNode: (n) => (n.parentElement && n.parentElement.closest("[data-typing]") ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT),
          });
          const nodes = [];
          let node;
          while ((node = walker.nextNode())) if (node.nodeValue && node.nodeValue.trim()) nodes.push({ n: node, t: node.nodeValue });
          if (!nodes.length) { animating.delete(el); return; }
          let total = 0;
          for (const o of nodes) total += o.t.length;
          // кожен символ мерехтить від старту до свого моменту фіксації (40–95% тривалості),
          // тож навіть одиночна велика літера явно перебирається
          const lockAt = new Array(total);
          for (let i = 0; i < total; i++) lockAt[i] = dur * (0.4 + 0.55 * Math.random());
          const roll = [];
          const t0 = performance.now();
          let lastRoll = -999;
          function tick(now) {
            const t = now - t0;
            const reroll = now - lastRoll > 45; // темп перебору символів
            if (reroll) lastRoll = now;
            let gi = 0, done = true;
            for (const o of nodes) {
              let s = "";
              for (let i = 0; i < o.t.length; i++, gi++) {
                const c = o.t[i];
                if (c === " " || c === "\n") { s += c; continue; }
                if (t >= lockAt[gi]) s += c;
                else { done = false; if (reroll || roll[gi] === undefined) roll[gi] = rnd(); s += roll[gi]; }
              }
              o.n.nodeValue = s;
            }
            if (!done) requestAnimationFrame(tick);
            else { nodes.forEach((o) => (o.n.nodeValue = o.t)); animating.delete(el); }
          }
          requestAnimationFrame(tick);
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries)
              if (e.isIntersecting) scramble(e.target, 850 + Math.min(1000, (e.target.textContent || "").replace(/\s/g, "").length * 40));
          },
          { threshold: 0.25 }
        );
        document.querySelectorAll(".display, .page-h, .case-h").forEach((el) => io.observe(el));
      })();
    </script>

    <script>
      // Стрілки: при появі у в'юпорті на місці стрілки мигтять випадкові символи,
      // а в кінці з'являється сама стрілка — той самий підхід, що й scramble заголовків.
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const arrows = document.querySelectorAll(".wc-arrow, [data-arrow]");
        if (!arrows.length) return;
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#*+=<>↗→↑↓";
        const animating = new WeakSet();
        function reveal(el, dur) {
          if (animating.has(el)) return;
          animating.add(el);
          const svg = el.querySelector("svg");
          const cy = el.querySelector(".wc-cy");
          if (!cy) { animating.delete(el); return; }
          if (svg) svg.style.opacity = "0";
          cy.style.display = "flex";
          const start = performance.now();
          let last = -999;
          function tick(now) {
            const p = Math.min(1, (now - start) / dur);
            if (now - last > 55) { last = now; cy.textContent = chars[(Math.random() * chars.length) | 0]; }
            if (p < 1) requestAnimationFrame(tick);
            else { cy.style.display = "none"; cy.textContent = ""; if (svg) svg.style.opacity = ""; animating.delete(el); }
          }
          requestAnimationFrame(tick);
        }
        const io = new IntersectionObserver(
          (entries) => { for (const e of entries) if (e.isIntersecting) reveal(e.target, 650); },
          { threshold: 0.6 }
        );
        arrows.forEach((a) => io.observe(a));
      })();
    </script>

    <script>
      // Відео стартує саме. «Пояс + підтяжки»:
      //  1) autoplay-атрибут + IntersectionObserver play() у полі зору;
      //  2) фолбек: перша взаємодія (скрол/тач/клік) — це user-gesture, який
      //     дозволяє play() навіть коли автозапуск заблоковано (Safari per-site
      //     Auto-Play = Never для localhost). Паузу на виході НЕ ставимо.
      (() => {
        const vids = Array.from(document.querySelectorAll("video[data-autoplay]"));
        if (!vids.length) return;
        vids.forEach((v) => {
          v.muted = true; v.defaultMuted = true; v.playsInline = true;
          v.setAttribute("muted", ""); v.setAttribute("playsinline", ""); v.setAttribute("webkit-playsinline", "");
        });
        const tryPlay = (v) => {
          v.muted = true;
          const p = v.play();
          if (p && p.catch) p.catch(() => {
            const retry = () => { v.muted = true; const q = v.play(); if (q && q.catch) q.catch(() => {}); };
            v.addEventListener("loadeddata", retry, { once: true });
            v.addEventListener("canplay", retry, { once: true });
            if (v.readyState < 2) { try { v.load(); } catch (e) {} }
          });
        };
        const io = new IntersectionObserver(
          (entries) => { for (const e of entries) if (e.isIntersecting) tryPlay(e.target); },
          { threshold: 0.15 }
        );
        vids.forEach((v) => io.observe(v));
        // фолбек: перший жест користувача розблоковує play() будь-де
        const kick = () => vids.forEach((v) => { if (v.paused) tryPlay(v); });
        ["pointerdown", "touchstart", "keydown", "wheel", "scroll"].forEach((ev) =>
          window.addEventListener(ev, kick, { once: true, passive: true }));
      })();
    </script>

    <script>
      // ── ПЕРЕХІД «КОЛОНИ» між сторінками (у стилі steviaplease.me) ─────
      // 12 вертикальних колон, keyframes-анімація зі стагером зліва направо.
      // Керується ЛИШЕ CSS-класами (pt-cover / pt-reveal) — надійно, без WAAPI,
      // тому не деградує після кількох переходів.
      (() => {
        const el = document.getElementById("pagecover");
        const root = document.documentElement;
        if (!el || matchMedia("(prefers-reduced-motion: reduce)").matches) {
          root.classList.remove("pt-arriving");
          return;
        }
        const cols = [...el.querySelectorAll(".pc-col")];
        const last = cols[cols.length - 1];
        const KEY = "pt-cover";
        let navigating = false;

        // Скільки триває вся хвиля (остання колона + її затримка) — для страховки.
        function totalMs() {
          const cs = getComputedStyle(root);
          const dur = parseFloat(cs.getPropertyValue("--transition-dur")) || 560;
          const step = parseFloat(cs.getPropertyValue("--transition-step")) || 34;
          return dur + cols.length * step + 120;
        }

        // Викликає cb, коли остання колона доанімувала (+ страховка, якщо animationend не прийшов).
        function onDone(cb) {
          let fired = false;
          const fin = () => { if (fired) return; fired = true; cb(); };
          last.addEventListener("animationend", fin, { once: true });
          setTimeout(fin, totalMs() + 250);
        }

        function reset() {
          navigating = false;
          el.classList.remove("is-busy", "pt-cover", "pt-reveal");
          root.classList.remove("pt-arriving");
        }

        // Відкриття — ЛИШЕ якщо прийшли через перехід (прапорець). Свіже завантаження/refresh → сторінка одразу.
        let arriving = false;
        try { arriving = !!sessionStorage.getItem(KEY); if (arriving) sessionStorage.removeItem(KEY); } catch (_) {}
        if (arriving) {
          el.classList.add("is-busy", "pt-reveal");   // колони накрито (pt-arriving) → їдуть угору
          onDone(reset);
        } else {
          root.classList.remove("pt-arriving");
        }

        // bfcache back/forward — показати сторінку без залишків завіси.
        addEventListener("pageshow", (e) => { if (e.persisted) reset(); });
        // Заморозка у bfcache — прибрати накриття, щоб при поверненні не залипло.
        addEventListener("pagehide", () => { el.classList.remove("pt-cover"); });

        // Перехоплюємо внутрішні переходи: накрити колонами → перейти.
        addEventListener("click", (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = e.target.closest("a");
          if (!a) return;
          const href = a.getAttribute("href");
          if (!href || a.target === "_blank" || a.hasAttribute("download")) return;
          if (href.startsWith("mailto:") || href.startsWith("tel:") || href.startsWith("#")) return;
          let url;
          try { url = new URL(a.href, location.href); } catch { return; }
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname) return; // той самий шлях (якір) → плавний скрол
          e.preventDefault();
          if (navigating) return;
          navigating = true;
          try { sessionStorage.setItem(KEY, "1"); } catch (_) {}
          el.classList.add("is-busy", "pt-cover");
          onDone(() => { location.href = a.href; });
        });
      })();
    </script>

    <script>
      // Scramble/перебір літер при наведенні на посилання (.link-fx).
      // Той самий «дешифрувальний» ефект, що й на заголовках, але тригер — hover.
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#*_—";
        const rnd = () => chars[(Math.random() * chars.length) | 0];
        const busy = new WeakSet();
        function scramble(el, dur) {
          if (busy.has(el)) return;
          busy.add(el);
          const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
          const nodes = [];
          let node;
          while ((node = walker.nextNode())) if (node.nodeValue && node.nodeValue.trim()) nodes.push({ n: node, t: node.nodeValue });
          if (!nodes.length) { busy.delete(el); return; }
          let total = 0;
          for (const o of nodes) total += o.t.length;
          const lockAt = new Array(total);
          for (let i = 0; i < total; i++) lockAt[i] = dur * (0.3 + 0.6 * Math.random());
          const roll = [];
          const t0 = performance.now();
          let last = -999;
          function tick(now) {
            const t = now - t0;
            const reroll = now - last > 45;
            if (reroll) last = now;
            let gi = 0, done = true;
            for (const o of nodes) {
              let s = "";
              for (let i = 0; i < o.t.length; i++, gi++) {
                const c = o.t[i];
                if (c === " " || c === "\n") { s += c; continue; }
                if (t >= lockAt[gi]) s += c;
                else { done = false; if (reroll || roll[gi] === undefined) roll[gi] = rnd(); s += roll[gi]; }
              }
              o.n.nodeValue = s;
            }
            if (!done) requestAnimationFrame(tick);
            else { nodes.forEach((o) => (o.n.nodeValue = o.t)); busy.delete(el); }
          }
          requestAnimationFrame(tick);
        }
        document.addEventListener("mouseover", (e) => {
          const el = e.target.closest(".link-fx");
          if (!el) return;
          if (e.relatedTarget && el.contains(e.relatedTarget)) return; // рух усередині — ігнор
          scramble(el, 420);
        });
      })();
    </script>
  </body>
</html>
