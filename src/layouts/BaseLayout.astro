---
/**
 * BaseLayout — шарова оболонка сайту 1:1 з Figma "Portfolio 2.0".
 * Навбар: логотип · центральна glass-пігулка (HOME/WORK/LAB/ABOUT) · перемикач
 * теми · ім'я/роль. Футер: CONTACT · координати+годинник · DESLUK · legal.
 * Тема (light/dark) керується [data-theme] на <html> з no-FOUC інлайн-скриптом.
 */
import "../styles/global.css";
import { Image } from "astro:assets";
import { SITE, SOCIALS } from "../consts";
import logoSvg from "../assets/icons/logo.svg?raw";
import SectionMarker from "../components/SectionMarker.astro";
import deslukBlack from "../assets/footer/desluk-black.png"; // чорний DESLUK — світла тема
import deslukWhite from "../assets/footer/desluk-white.png"; // білий DESLUK — темна тема

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description = SITE.description,
  canonical,
  ogType = "website",
  jsonLd,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL("/og-default.png", Astro.site).href;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const nav = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/projects" },
  { label: "Lab", href: "/lab" },
  { label: "About", href: "/about-me" },
];
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");

const linkedin = SOCIALS.find((s) => s.label === "LinkedIn");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  address: { "@type": "PostalAddress", addressLocality: SITE.location },
  sameAs: SOCIALS.map((s) => s.href),
};
const schemas = [personSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preload" href="/fonts/Monoska-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {/* No-FOUC: застосувати збережену тему до першого малювання */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (t === "light" || t === "dark")
            document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>

  <body>
    <!-- Прогресивний blur по верхньому й нижньому краю (ефект при скролі).
         3 шари з наростаючим блюром + градієнтна маска = плавний перехід. -->
    <div class="edge-blur edge-blur--top" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="edge-blur edge-blur--bottom" aria-hidden="true"><i></i><i></i><i></i></div>

    <!-- НАВБАР -->
    <header class="nav">
      <a href="/" class="nav-logo" aria-label={`${SITE.name} — home`} set:html={logoSvg} />

      <div class="nav-center">
        <nav class="nav-pill glass" aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} class:list={["nav-link", isActive(n.href) && "is-active"]}>{n.label}</a>
          ))}
        </nav>
        <button id="themeToggle" class="theme-toggle glass" type="button" aria-label="Toggle color theme">
          <svg class="ico-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.6 4.6l1.7 1.7M17.7 17.7l1.7 1.7M19.4 4.6l-1.7 1.7M6.3 17.7l-1.7 1.7" />
          </svg>
          <svg class="ico-moon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z" />
          </svg>
        </button>
      </div>

      <div class="nav-id label">
        <span>{SITE.name}</span>
        <span class="nav-role">UX/UI/Product Designer</span>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ФУТЕР -->
    <footer class="footer">
      <div class="foot-card">
        <div class="foot-top">
          <div class="foot-contact">
            <SectionMarker label="Contact" style="margin-bottom:20px" />
            <dl class="foot-dl label">
              <div class="foot-row"><dt>Mail</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
              {linkedin && (
                <div class="foot-row"><dt>LinkedIn</dt><dd><a href={linkedin.href} target="_blank" rel="noopener noreferrer">Anton_Lukovyi ↗</a></dd></div>
              )}
            </dl>
          </div>
          <div class="foot-geo label">
            <span>52.62.10.00E — {SITE.location}</span>
            <span class="foot-clock" data-clock>--:--:--</span>
          </div>
        </div>

        <div class="foot-mark">
          <Image src={deslukBlack} alt="DESLUK" class="fm-img fm-light" widths={[720, 1320, 2200]} sizes="(max-width: 720px) 90vw, 92vw" loading="lazy" />
          <Image src={deslukWhite} alt="" aria-hidden="true" class="fm-img fm-dark" widths={[720, 1320, 2200]} sizes="(max-width: 720px) 90vw, 92vw" loading="lazy" />
        </div>

        <div class="foot-bottom">
          <hr class="rule" />
          <div class="foot-legal label">
            <span>© {year} {SITE.name}. All rights reserved.</span>
            <span class="foot-legal-links">
              <a href="/privacy">Privacy Policy</a>
              <a href="/terms">Terms &amp; Conditions</a>
            </span>
          </div>
        </div>
      </div>
    </footer>

    <style>
      /* ---------- Прогресивний BLUR по краях (на скролі) ---------- */
      .edge-blur {
        position: fixed; left: 0; right: 0; height: var(--blur-height); z-index: 30;
        pointer-events: none; overflow: hidden;
        opacity: 1; transition: opacity .35s ease;
      }
      /* вимикається залежно від позиції скролу (див. скрипт нижче) */
      .edge-blur.is-off { opacity: 0; }
      /* Без підфарбування — тільки чистий blur. Однаково на світлій і темній
         темі (не залежить від теми, нічого не перемикається). */
      .edge-blur--top { top: 0; }
      .edge-blur--bottom { bottom: 0; }
      .edge-blur > i { position: absolute; inset: 0; display: block; }

      /* три шари: слабкий по всій смузі → найсильніший біля самого краю */
      .edge-blur--top > i:nth-child(1) { backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%);
        mask-image: linear-gradient(to bottom, #000 0%, #000 45%, transparent 100%); }
      .edge-blur--top > i:nth-child(2) { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 22%, transparent 62%);
        mask-image: linear-gradient(to bottom, #000 0%, #000 22%, transparent 62%); }
      .edge-blur--top > i:nth-child(3) { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 38%);
        mask-image: linear-gradient(to bottom, #000 0%, transparent 38%); }

      .edge-blur--bottom > i:nth-child(1) { backdrop-filter: blur(2px); -webkit-backdrop-filter: blur(2px);
        -webkit-mask-image: linear-gradient(to top, #000 0%, #000 45%, transparent 100%);
        mask-image: linear-gradient(to top, #000 0%, #000 45%, transparent 100%); }
      .edge-blur--bottom > i:nth-child(2) { backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
        -webkit-mask-image: linear-gradient(to top, #000 0%, #000 22%, transparent 62%);
        mask-image: linear-gradient(to top, #000 0%, #000 22%, transparent 62%); }
      .edge-blur--bottom > i:nth-child(3) { backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        -webkit-mask-image: linear-gradient(to top, #000 0%, transparent 38%);
        mask-image: linear-gradient(to top, #000 0%, transparent 38%); }

      @media (max-width: 720px) { .edge-blur { height: 92px; } }
      @media (prefers-reduced-motion: reduce) { .edge-blur { display: none; } }

      /* ---------- НАВБАР ---------- */
      .nav {
        position: sticky; top: 0; z-index: 50;
        display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
        gap: 1rem; padding: var(--nav-pad-y) var(--pad-side);
      }
      .nav-logo { color: var(--icon-primary); width: 46px; height: 48px; }
      .nav-logo :global(svg) { width: 100%; height: 100%; }

      .nav-center { display: flex; justify-content: center; align-items: center; gap: 10px; }
      .nav-pill { display: flex; gap: 2px; padding: 4px; border-radius: 999px; }
      .nav-link {
        font-family: var(--font-display); font-size: var(--size-sm); text-transform: uppercase;
        color: var(--text-muted); padding: 8px 16px; border-radius: 999px;
        transition: color .15s, background .15s;
      }
      .nav-link:hover { color: var(--text-primary); }
      .nav-link.is-active { color: var(--text-accent); }

      .theme-toggle {
        display: inline-flex; align-items: center; justify-content: center;
        width: 44px; height: 44px; border-radius: 999px; cursor: pointer;
        color: var(--icon-primary); padding: 0;
      }
      .theme-toggle:hover { color: var(--text-accent); }
      /* показуємо іконку відповідно до активної теми */
      .ico-sun { display: none; }
      .ico-moon { display: block; }
      :root[data-theme="dark"] .ico-sun { display: block; }
      :root[data-theme="dark"] .ico-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .ico-sun { display: block; }
        :root:not([data-theme="light"]) .ico-moon { display: none; }
      }

      .nav-id {
        justify-self: end; text-align: right; color: var(--text-primary);
        display: flex; flex-direction: column; line-height: 1.35;
      }
      .nav-role { color: var(--text-muted); }

      @media (max-width: 720px) {
        .nav { grid-template-columns: auto 1fr auto; gap: 8px; padding: 12px 16px; }
        .nav-id { display: none; }
        .nav-center { justify-content: flex-end; }
        .nav-link { padding: 7px 11px; }
        .nav-pill { gap: 0; }
      }

      /* ---------- ФУТЕР (картка, 1:1 з Figma-компонентом) ---------- */
      .footer { margin-top: var(--section-gap); padding: 0 0 24px; }
      /* картка: surface/raised + border/subtle + radius, з полями по краях;
         розтягується з в'юпортом. Кольори з токенів → однаково в чорній/білій темі.
         Розміри — з панелі керування (controls.css). */
      .foot-card {
        margin-inline: var(--footer-margin); padding: var(--footer-pad);
        background: var(--surface-raised);
        border: 1px solid var(--border-subtle);
        border-radius: var(--footer-radius);
      }
      /* верхній рядок має роздільник знизу (border-bottom) + відступ під ним */
      .foot-top { display: grid; grid-template-columns: 1fr auto; gap: 2rem; padding-bottom: var(--footer-gap); border-bottom: 1px solid var(--border-subtle); }
      .foot-dl { display: grid; gap: 8px; margin: 0; }
      .foot-row { display: grid; grid-template-columns: 120px 1fr; gap: 12px; }
      .foot-row dt { color: var(--text-muted); }
      .foot-row dd { margin: 0; color: var(--text-primary); }
      .foot-row a:hover { color: var(--text-accent); }
      .foot-geo { display: flex; flex-direction: column; align-items: flex-end; gap: 20px; color: var(--text-muted); text-align: right; }

      /* DESLUK — картинка з Figma (4x). Дві версії: чорна (світла тема) /
         біла (темна тема), перемикаються так само, як іконки теми. */
      .foot-mark { margin-top: var(--footer-gap); }
      .fm-img { width: 100%; height: auto; display: block; }
      .fm-dark { display: none; }
      :root[data-theme="dark"] .fm-light { display: none; }
      :root[data-theme="dark"] .fm-dark { display: block; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .fm-light { display: none; }
        :root:not([data-theme="light"]) .fm-dark { display: block; }
      }

      .foot-bottom { margin-top: var(--footer-gap); }
      .foot-legal { display: flex; justify-content: space-between; gap: 1rem; margin-top: var(--footer-gap); color: var(--text-muted); }
      .foot-legal-links { display: inline-flex; gap: 40px; }
      .foot-legal a:hover { color: var(--text-accent); }

      @media (max-width: 720px) {
        .foot-card { margin-inline: 16px; padding: 20px; }
      }

      @media (max-width: 640px) {
        .foot-top { grid-template-columns: 1fr; }
        .foot-geo { align-items: flex-start; text-align: left; }
        .foot-row { grid-template-columns: 88px 1fr; }
        .foot-legal { flex-direction: column; gap: 12px; }
        .foot-legal-links { gap: 24px; }
      }
    </style>

    <!-- Живий годинник у футері -->
    <script>
      function tickClock() {
        const els = document.querySelectorAll("[data-clock]");
        if (!els.length) return;
        const p = (n: number) => String(n).padStart(2, "0");
        const now = new Date();
        const t = `${p(now.getHours())}:${p(now.getMinutes())}:${p(now.getSeconds())}`;
        els.forEach((el) => (el.textContent = t));
      }
      tickClock();
      const w = window as any;
      if (!w.__clock) w.__clock = setInterval(tickClock, 1000);
      document.addEventListener("astro:page-load", tickClock);
    </script>

    <!-- Edge-blur залежно від скролу: вгорі — ховаємо нижній, внизу — верхній -->
    <script>
      const wb = window as any;
      if (!wb.__edgeBlur) {
        wb.__edgeBlur = true;
        let ticking = false;
        function updateBlur() {
          ticking = false;
          const top = document.querySelector(".edge-blur--top");
          const bot = document.querySelector(".edge-blur--bottom");
          if (!top || !bot) return;
          const y = window.scrollY;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const nearTop = y <= 8;
          const nearBottom = y >= max - 8;
          // верхній blur зникає біля нижньої межі;
          // нижній blur зникає біля обох меж (щоб і футер знизу було чітко видно)
          top.classList.toggle("is-off", nearBottom);
          bot.classList.toggle("is-off", nearTop || nearBottom);
        }
        function onScroll() {
          if (!ticking) { ticking = true; requestAnimationFrame(updateBlur); }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        document.addEventListener("astro:page-load", updateBlur);
        updateBlur();
      }
    </script>

    <!-- Перемикач теми (делегування, біндиться один раз) -->
    <script>
      const w = window as any;
      if (!w.__themeBound) {
        w.__themeBound = true;
        document.addEventListener("click", (e) => {
          const t = e.target as HTMLElement;
          if (!t.closest("#themeToggle")) return;
          const root = document.documentElement;
          const cur =
            root.getAttribute("data-theme") ||
            (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          const next = cur === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (err) {}
        });
      }
    </script>
  </body>
</html>
