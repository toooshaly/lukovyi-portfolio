---
/**
 * BaseLayout — спільний каркас для всіх сторінок.
 * Задає <head> (мета, canonical, favicon, стилі) і обгортку сторінки.
 * Header/Footer під'єднаємо на кроці 3.
 */
import "../styles/global.css";
import { SITE } from "../consts";

interface Props {
  /** Заголовок вкладки браузера + <title> (унікальний на кожній сторінці) */
  title: string;
  /** Meta description (унікальний на кожній сторінці) */
  description?: string;
  /** Перевизначити canonical URL за потреби */
  canonical?: string;
  /** Прибрати сторінку з індексації пошуковиків */
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  canonical,
  noindex = false,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <slot />
  </body>
</html>
