---
/**
 * DesktopLayout — каркас для головної у стилі macOS-робочого столу.
 * Без Header/Footer сайту: сторінка сама є «операційною системою».
 * SEO-теги збережено (Person/WebSite JSON-LD), щоб головна індексувалась.
 */
import "../styles/global.css";
import { SITE, SOCIALS } from "../consts";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${SITE.name} — ${SITE.role}`,
  description = SITE.description,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL("/og-default.png", Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  email: `mailto:${SITE.email}`,
  address: { "@type": "PostalAddress", addressLocality: SITE.location },
  sameAs: SOCIALS.map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#8aa4c8" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>

  <body class="os-body">
    <slot />
  </body>
</html>

<style is:global>
  /* Тема робочого столу (default — блакитна «linen»; перемикач змінює це) */
  :root {
    --wall: radial-gradient(
        140% 120% at 50% 0%,
        #6f88ae 0%,
        #8ba5c6 42%,
        #b3c7dd 100%
      );
    --panel: rgba(255, 255, 255, 0.55);
    --panel-strong: rgba(255, 255, 255, 0.82);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #1c2530;
    --ink-soft: #55627a;
    --shadow: 0 12px 40px rgba(23, 37, 66, 0.18);
    --label-bg: rgba(255, 255, 255, 0.4);
  }
  /* Теми (перемикач у віджеті). Значення міняють шпалеру + панелі. */
  :root[data-theme="sand"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #c9a888 0%, #ddc3ab 45%, #efe0d1 100%);
    --panel: rgba(255, 255, 255, 0.5);
    --panel-strong: rgba(255, 253, 250, 0.85);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #3a2c22;
    --ink-soft: #7a6656;
    --shadow: 0 12px 40px rgba(74, 52, 34, 0.18);
    --label-bg: rgba(255, 255, 255, 0.45);
  }
  :root[data-theme="green"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #7fa07f 0%, #a6c0a2 45%, #cfe0cd 100%);
    --panel: rgba(255, 255, 255, 0.52);
    --panel-strong: rgba(252, 255, 251, 0.85);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #223026;
    --ink-soft: #566a5b;
    --shadow: 0 12px 40px rgba(30, 55, 38, 0.18);
    --label-bg: rgba(255, 255, 255, 0.45);
  }
  :root[data-theme="dark"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #2a2f38 0%, #20242c 45%, #14171d 100%);
    --panel: rgba(40, 46, 58, 0.55);
    --panel-strong: rgba(38, 44, 56, 0.8);
    --panel-border: rgba(255, 255, 255, 0.12);
    --ink: #e9edf5;
    --ink-soft: #9aa6bd;
    --shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    --label-bg: rgba(255, 255, 255, 0.1);
  }

  /* Скидаємо темну тему сайту для головної: тут світлий macOS-look */
  html,
  body.os-body {
    height: 100%;
  }
  body.os-body {
    margin: 0;
    background: var(--wall);
    color: #1c2530;
    font-family:
      -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui, "Segoe UI",
      Roboto, sans-serif;
    overflow: hidden;
  }
</style>
