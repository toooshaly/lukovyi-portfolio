---
/**
 * OSLayout — спільний каркас «робочого столу» для ВСІХ сторінок.
 * Шпалера + MenuBar + Dock persist через View Transitions, тому при відкритті
 * кейсу вони не блимають — сторінка-кейс з'являється як вікно на тому ж столі.
 * SEO збережено: кожна сторінка — справжній HTML з власним URL.
 */
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { SITE, SOCIALS } from "../consts";
import MenuBar from "../components/os/MenuBar.astro";
import Dock from "../components/os/Dock.astro";
import Desktop from "../components/os/Desktop.astro";
import Spotlight from "../components/os/Spotlight.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Головна (екран блокування) — приховує menubar/dock під lock-оверлеєм */
  showChrome?: boolean;
}

const {
  title = `${SITE.name} — ${SITE.role}`,
  description = SITE.description,
  canonical,
  noindex = false,
  ogImage = "/og-default.png",
  ogType = "website",
  jsonLd,
  showChrome = true,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.name,
      jobTitle: SITE.role,
      url: SITE.url,
      email: `mailto:${SITE.email}`,
      address: { "@type": "PostalAddress", addressLocality: SITE.location },
      sameAs: SOCIALS.map((s) => s.href),
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      publisher: { "@id": `${SITE.url}/#person` },
    },
  ],
};
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#8aa4c8" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {pageSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <ClientRouter />
  </head>

  <body class="os-body">
    {showChrome && <MenuBar />}
    {showChrome && <Desktop />}
    <slot />
    {showChrome && <Dock />}
    {showChrome && <Spotlight />}
  </body>
</html>

<style is:global>
  /* Теми робочого столу (перемикач змінює --wall тощо) */
  :root {
    --wall: radial-gradient(140% 120% at 50% 0%, #6f88ae 0%, #8ba5c6 42%, #b3c7dd 100%);
    --panel: rgba(255, 255, 255, 0.55);
    --panel-strong: rgba(255, 255, 255, 0.82);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #1c2530;
    --ink-soft: #55627a;
    --shadow: 0 12px 40px rgba(23, 37, 66, 0.18);
    --label-bg: rgba(255, 255, 255, 0.4);
  }
  :root[data-theme="sand"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #c9a888 0%, #ddc3ab 45%, #efe0d1 100%);
    --panel: rgba(255, 255, 255, 0.5);
    --panel-strong: rgba(255, 253, 250, 0.85);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #3a2c22;
    --ink-soft: #7a6656;
    --shadow: 0 12px 40px rgba(74, 52, 34, 0.18);
    --label-bg: rgba(255, 255, 255, 0.45);
  }
  :root[data-theme="green"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #7fa07f 0%, #a6c0a2 45%, #cfe0cd 100%);
    --panel: rgba(255, 255, 255, 0.52);
    --panel-strong: rgba(252, 255, 251, 0.85);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #223026;
    --ink-soft: #566a5b;
    --shadow: 0 12px 40px rgba(30, 55, 38, 0.18);
    --label-bg: rgba(255, 255, 255, 0.45);
  }
  :root[data-theme="dark"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #2a2f38 0%, #20242c 45%, #14171d 100%);
    --panel: rgba(40, 46, 58, 0.55);
    --panel-strong: rgba(38, 44, 56, 0.8);
    --panel-border: rgba(255, 255, 255, 0.12);
    --ink: #e9edf5;
    --ink-soft: #9aa6bd;
    --shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    --label-bg: rgba(255, 255, 255, 0.1);
  }

  html,
  body.os-body {
    height: 100%;
  }
  body.os-body {
    margin: 0;
    min-height: 100%;
    background: var(--wall);
    background-attachment: fixed;
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui,
      "Segoe UI", Roboto, sans-serif;
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  // Живий годинник + застосування збереженої теми. Guard, щоб View Transitions
  // не плодили кілька інтервалів.
  function pad(n: number) { return String(n).padStart(2, "0"); }
  function tick() {
    const now = new Date();
    const time = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
    const date = now.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set("lockClock", time); set("barClock", time); set("lockDate", date); set("barDate", date);
  }
  function applyTheme() {
    const t = localStorage.getItem("os-theme");
    if (t) document.documentElement.dataset.theme = t;
    else document.documentElement.removeAttribute("data-theme");
  }
  function initClock() {
    tick();
    const w = window as any;
    if (!w.__clock) w.__clock = setInterval(tick, 1000);
  }
  // Інтерактив робочого столу (персистентний, тож слухачі вішаємо один раз)
  function initDesktop() {
    const w = window as any;
    if (w.__desktopInit) return;
    w.__desktopInit = true;

    document.querySelectorAll<HTMLButtonElement>(".sw").forEach((btn) => {
      btn.addEventListener("click", () => {
        const t = btn.dataset.theme || "";
        if (t) document.documentElement.dataset.theme = t;
        else document.documentElement.removeAttribute("data-theme");
        localStorage.setItem("os-theme", t);
      });
    });

    const pw = document.getElementById("pw");
    let target = "/projects";
    document.querySelectorAll<HTMLAnchorElement>('.icon[data-pw="1"]').forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        target = a.getAttribute("href") || "/projects";
        if (pw) pw.hidden = false;
      });
    });
    document.getElementById("pwCancel")?.addEventListener("click", () => { if (pw) pw.hidden = true; });
    document.getElementById("pwUnlock")?.addEventListener("click", () => {
      if (pw) pw.hidden = true;
      navigate(target);
    });
    pw?.addEventListener("click", (e) => { if (e.target === pw && pw) pw.hidden = true; });

    // Now Playing плеєр
    const audio = document.getElementById("npAudio") as HTMLAudioElement | null;
    const npPlay = document.getElementById("npPlay");
    const npIco = document.getElementById("npIco");
    const npFill = document.getElementById("npFill");
    const npBar = document.getElementById("npBar");
    if (audio && npPlay) {
      npPlay.addEventListener("click", () => {
        if (audio.paused) audio.play().then(() => { if (npIco) npIco.textContent = "❚❚"; }).catch(() => {});
        else { audio.pause(); if (npIco) npIco.textContent = "▶"; }
      });
      audio.addEventListener("timeupdate", () => {
        if (npFill && audio.duration) npFill.style.width = (audio.currentTime / audio.duration) * 100 + "%";
      });
      audio.addEventListener("ended", () => { if (npIco) npIco.textContent = "▶"; if (npFill) npFill.style.width = "0%"; });
      npBar?.addEventListener("click", (e) => {
        const r = npBar.getBoundingClientRect();
        if (audio.duration) audio.currentTime = ((e as MouseEvent).clientX - r.left) / r.width * audio.duration;
      });
    }

    // Перетягувані іконки (позиції в localStorage)
    const iconsWrap = document.querySelector(".icons") as HTMLElement | null;
    if (iconsWrap) {
      const saved = JSON.parse(localStorage.getItem("os-icons") || "{}");
      iconsWrap.querySelectorAll<HTMLElement>(".icon").forEach((el) => {
        const key = el.dataset.key!;
        el.draggable = false;
        if (saved[key]) { el.style.left = saved[key].x + "px"; el.style.top = saved[key].y + "px"; }
        let sx = 0, sy = 0, ox = 0, oy = 0, drag = false, moved = false;
        el.addEventListener("pointerdown", (e) => {
          drag = true; moved = false;
          sx = e.clientX; sy = e.clientY;
          ox = parseFloat(el.style.left) || 0; oy = parseFloat(el.style.top) || 0;
          el.setPointerCapture(e.pointerId);
        });
        el.addEventListener("pointermove", (e) => {
          if (!drag) return;
          const dx = e.clientX - sx, dy = e.clientY - sy;
          if (Math.abs(dx) + Math.abs(dy) > 4) moved = true;
          if (moved) { el.style.left = ox + dx + "px"; el.style.top = Math.max(0, oy + dy) + "px"; el.style.zIndex = "5"; }
        });
        el.addEventListener("pointerup", () => {
          drag = false;
          if (moved) {
            saved[key] = { x: parseFloat(el.style.left), y: parseFloat(el.style.top) };
            localStorage.setItem("os-icons", JSON.stringify(saved));
            (window as any).__iconDragged = true;
          }
        });
        el.addEventListener("click", (e) => {
          if ((window as any).__iconDragged) { e.preventDefault(); e.stopImmediatePropagation(); (window as any).__iconDragged = false; }
        }, true);
      });
    }

    // Контекстне меню (права кнопка на столі) + About This Mac
    const ctx = document.getElementById("ctx");
    const about = document.getElementById("about-mac");
    const hideCtx = () => { if (ctx) ctx.hidden = true; };
    document.addEventListener("contextmenu", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest(".win") || t.closest("input") || t.closest("textarea") || t.closest(".menubar") || t.closest(".dock")) return;
      if (!ctx) return;
      e.preventDefault();
      ctx.hidden = false;
      ctx.style.left = Math.min(e.clientX, window.innerWidth - 200) + "px";
      ctx.style.top = Math.min(e.clientY, window.innerHeight - 140) + "px";
    });
    document.addEventListener("click", () => hideCtx());
    const themeOrder = ["", "sand", "green", "dark"];
    ctx?.querySelectorAll<HTMLButtonElement>(".ctx-item").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        hideCtx();
        const act = btn.dataset.action;
        if (act === "about" && about) about.hidden = false;
        else if (act === "theme") {
          const cur = document.documentElement.dataset.theme || "";
          const next = themeOrder[(themeOrder.indexOf(cur) + 1) % themeOrder.length];
          if (next) document.documentElement.dataset.theme = next;
          else document.documentElement.removeAttribute("data-theme");
          localStorage.setItem("os-theme", next);
        } else if (act === "cleanup") {
          localStorage.removeItem("os-icons");
          iconsWrap?.querySelectorAll<HTMLElement>(".icon").forEach((el, i) => {
            el.style.left = (i % 4) * 112 + "px"; el.style.top = Math.floor(i / 4) * 132 + "px"; el.style.zIndex = "";
          });
        }
      });
    });
    document.getElementById("amClose")?.addEventListener("click", () => { if (about) about.hidden = true; });
    about?.addEventListener("click", (e) => { if (e.target === about) about.hidden = true; });

    // Esc закриває відкрите вікно-сторінку (повернення на стіл)
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const anyOverlay = [document.getElementById("spotlight"), document.getElementById("pw"), about, ctx]
        .some((el) => el && !(el as HTMLElement).hidden);
      if (anyOverlay) return;
      if (document.querySelector(".win")) { e.preventDefault(); navigate("/"); }
    });

    // Виділення рамкою (rubber-band), як на ПК
    const marquee = document.getElementById("marquee");
    const allIcons = () => Array.from(document.querySelectorAll<HTMLElement>(".icon"));
    const clearSel = () => allIcons().forEach((el) => el.classList.remove("selected"));
    const isEmpty = (t: HTMLElement) =>
      ["desktop", "workspace", "stage", "icons"].some((c) => t.classList.contains(c));
    let mDrag = false, mMoved = false, mx0 = 0, my0 = 0;
    document.addEventListener("pointerdown", (e) => {
      const t = e.target as HTMLElement;
      if (e.button !== 0 || !isEmpty(t) || !marquee) return;
      mDrag = true; mMoved = false; mx0 = e.clientX; my0 = e.clientY;
      clearSel();
      marquee.hidden = false;
      marquee.style.cssText = `position:fixed;z-index:15;left:${mx0}px;top:${my0}px;width:0;height:0`;
    });
    document.addEventListener("pointermove", (e) => {
      if (!mDrag || !marquee) return;
      const x = Math.min(e.clientX, mx0), y = Math.min(e.clientY, my0);
      const w = Math.abs(e.clientX - mx0), h = Math.abs(e.clientY - my0);
      if (w > 3 || h > 3) mMoved = true;
      marquee.style.left = x + "px"; marquee.style.top = y + "px";
      marquee.style.width = w + "px"; marquee.style.height = h + "px";
      const r = { l: x, t: y, r: x + w, b: y + h };
      allIcons().forEach((el) => {
        const b = el.getBoundingClientRect();
        el.classList.toggle("selected", b.left < r.r && b.right > r.l && b.top < r.b && b.bottom > r.t);
      });
    });
    document.addEventListener("pointerup", () => {
      if (mDrag && marquee) { mDrag = false; marquee.hidden = true; }
    });
    document.addEventListener("click", (e) => {
      if (mMoved) { mMoved = false; return; }
      if (isEmpty(e.target as HTMLElement)) clearSel();
    });
  }

  applyTheme();
  initClock();
  initDesktop();
  // Після кожного переходу View Transitions — оновити тему й час
  document.addEventListener("astro:page-load", () => { applyTheme(); tick(); });
</script>
