---
/**
 * OSLayout — спільний каркас «робочого столу» для ВСІХ сторінок.
 * Шпалера + MenuBar + Dock persist через View Transitions, тому при відкритті
 * кейсу вони не блимають — сторінка-кейс з'являється як вікно на тому ж столі.
 * SEO збережено: кожна сторінка — справжній HTML з власним URL.
 */
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { SITE, SOCIALS } from "../consts";
import MenuBar from "../components/os/MenuBar.astro";
import Dock from "../components/os/Dock.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Головна (екран блокування) — приховує menubar/dock під lock-оверлеєм */
  showChrome?: boolean;
}

const {
  title = `${SITE.name} — ${SITE.role}`,
  description = SITE.description,
  canonical,
  noindex = false,
  ogImage = "/og-default.png",
  ogType = "website",
  jsonLd,
  showChrome = true,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

const baseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.name,
      jobTitle: SITE.role,
      url: SITE.url,
      email: `mailto:${SITE.email}`,
      address: { "@type": "PostalAddress", addressLocality: SITE.location },
      sameAs: SOCIALS.map((s) => s.href),
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      name: SITE.name,
      url: SITE.url,
      publisher: { "@id": `${SITE.url}/#person` },
    },
  ],
};
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#8aa4c8" />
    <meta name="generator" content={Astro.generator} />

    <script type="application/ld+json" set:html={JSON.stringify(baseSchema)} />
    {pageSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <ClientRouter />
  </head>

  <body class="os-body">
    {showChrome && <MenuBar />}
    <slot />
    {showChrome && <Dock />}
  </body>
</html>

<style is:global>
  /* Теми робочого столу (перемикач змінює --wall тощо) */
  :root {
    --wall: radial-gradient(140% 120% at 50% 0%, #6f88ae 0%, #8ba5c6 42%, #b3c7dd 100%);
    --panel: rgba(255, 255, 255, 0.55);
    --panel-strong: rgba(255, 255, 255, 0.82);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #1c2530;
    --ink-soft: #55627a;
    --shadow: 0 12px 40px rgba(23, 37, 66, 0.18);
    --label-bg: rgba(255, 255, 255, 0.4);
  }
  :root[data-theme="sand"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #c9a888 0%, #ddc3ab 45%, #efe0d1 100%);
    --panel: rgba(255, 255, 255, 0.5);
    --panel-strong: rgba(255, 253, 250, 0.85);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #3a2c22;
    --ink-soft: #7a6656;
    --shadow: 0 12px 40px rgba(74, 52, 34, 0.18);
    --label-bg: rgba(255, 255, 255, 0.45);
  }
  :root[data-theme="green"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #7fa07f 0%, #a6c0a2 45%, #cfe0cd 100%);
    --panel: rgba(255, 255, 255, 0.52);
    --panel-strong: rgba(252, 255, 251, 0.85);
    --panel-border: rgba(255, 255, 255, 0.6);
    --ink: #223026;
    --ink-soft: #566a5b;
    --shadow: 0 12px 40px rgba(30, 55, 38, 0.18);
    --label-bg: rgba(255, 255, 255, 0.45);
  }
  :root[data-theme="dark"] {
    --wall: radial-gradient(140% 120% at 50% 0%, #2a2f38 0%, #20242c 45%, #14171d 100%);
    --panel: rgba(40, 46, 58, 0.55);
    --panel-strong: rgba(38, 44, 56, 0.8);
    --panel-border: rgba(255, 255, 255, 0.12);
    --ink: #e9edf5;
    --ink-soft: #9aa6bd;
    --shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    --label-bg: rgba(255, 255, 255, 0.1);
  }

  html,
  body.os-body {
    height: 100%;
  }
  body.os-body {
    margin: 0;
    min-height: 100%;
    background: var(--wall);
    background-attachment: fixed;
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", system-ui,
      "Segoe UI", Roboto, sans-serif;
  }
</style>

<script>
  // Живий годинник + застосування збереженої теми. Guard, щоб View Transitions
  // не плодили кілька інтервалів.
  function pad(n: number) { return String(n).padStart(2, "0"); }
  function tick() {
    const now = new Date();
    const time = `${pad(now.getHours())}:${pad(now.getMinutes())}`;
    const date = now.toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
    const set = (id: string, v: string) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set("lockClock", time); set("barClock", time); set("lockDate", date); set("barDate", date);
  }
  function applyTheme() {
    const t = localStorage.getItem("os-theme");
    if (t) document.documentElement.dataset.theme = t;
    else document.documentElement.removeAttribute("data-theme");
  }
  function initClock() {
    tick();
    const w = window as any;
    if (!w.__clock) w.__clock = setInterval(tick, 1000);
  }
  applyTheme();
  initClock();
  // Після кожного переходу View Transitions — оновити тему й час
  document.addEventListener("astro:page-load", () => { applyTheme(); tick(); });
</script>
