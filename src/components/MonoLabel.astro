---
/**
 * MonoLabel — маленький моно-лейбл (напр. "ABOUT ME", "PROJECTS", "01").
 * Повторюваний елемент айдентики поточного сайту.
 */
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "font-mono text-xs uppercase tracking-[0.2em] text-muted",
    className,
  ]}
>
  <slot />
</span>
