---
/**
 * Container — єдина обгортка ширини й горизонтальних відступів.
 * Тримає весь контент у передбачуваній сітці на всіх сторінках.
 */
interface Props {
  /** HTML-тег обгортки (div за замовчуванням) */
  as?: string;
  class?: string;
}
const { as: Tag = "div", class: className = "" } = Astro.props;
---

<Tag class:list={["mx-auto w-full max-w-6xl px-6 sm:px-8", className]}>
  <slot />
</Tag>
