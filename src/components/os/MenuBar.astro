---
/**
 * MenuBar — верхня панель macOS. Присутня на всіх сторінках і «переживає»
 * переходи (transition:persist), тому не блимає при відкритті вікон-кейсів.
 */
import { SITE, SOCIALS } from "../../consts";
import Spiral from "./Spiral.astro";
const social = (label: string) =>
  SOCIALS.find((s) => s.label === label)?.href ?? "#";
---

<header class="menubar" transition:persist="menubar">
  <div class="menu-left">
    <a href="/" class="menu-name">
      <Spiral size={15} stroke="var(--ink)" width={2} /> {SITE.name}
    </a>
    <a class="menu-item" href="/about-me">About</a>
    <a class="menu-item" href="/projects">Work</a>
    <a class="menu-item" href="/contact">Contact</a>
  </div>
  <div class="menu-right">
    <button class="menu-search" data-spotlight aria-label="Search (⌘K)" title="Search  ⌘K">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2">
        <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line>
      </svg>
    </button>
    <a href={social("Instagram")} target="_blank" rel="noopener" aria-label="Instagram">◎</a>
    <a href={social("LinkedIn")} target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
    <span id="barDate">—</span>
    <span id="barClock">00:00</span>
  </div>
</header>

<style>
  .menubar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    background: var(--panel);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--panel-border);
    font-size: 0.8rem;
    color: var(--ink);
  }
  .menu-left,
  .menu-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .menu-name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--ink);
  }
  .menu-item,
  .menu-right a {
    opacity: 0.75;
    color: var(--ink);
  }
  .menu-right a,
  .menu-search {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    min-height: 26px;
  }
  .menu-search {
    background: none;
    border: 0;
    color: var(--ink);
    opacity: 0.75;
    cursor: pointer;
    padding: 0;
  }
  .menu-search:hover {
    opacity: 1;
  }
  .menu-item:hover,
  .menu-right a:hover {
    opacity: 1;
  }
</style>
