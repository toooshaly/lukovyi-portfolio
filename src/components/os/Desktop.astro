---
/**
 * Desktop — сам робочий стіл (іконки, віджети, інтро) + модалка-пароль.
 * Персистентний шар: присутній на КОЖНІЙ сторінці й видимий ПОЗАДУ вікон,
 * тому при відкритті кейсу стіл із папками лишається на місці (як у macOS).
 */
import { SITE, SOCIALS } from "../../consts";

const social = (label: string) =>
  SOCIALS.find((s) => s.label === label)?.href ?? "#";

const icons = [
  { label: "Case Studies", emoji: "📁", href: "/projects", pw: true },
  { label: "About Me", emoji: "📖", href: "/about-me" },
  { label: "Contact", emoji: "✉️", href: "/contact" },
  { label: "Resume", emoji: "📄", href: `mailto:${SITE.email}`, ext: true },
  { label: "Photos", emoji: "📷", href: social("Instagram"), ext: true },
  { label: "Dribbble", emoji: "🏀", href: social("Dribbble"), ext: true },
  { label: "Behance", emoji: "🎨", href: social("Behance"), ext: true },
  { label: "LinkedIn", emoji: "💼", href: social("LinkedIn"), ext: true },
];
---

<div class="desktop" transition:persist="desktop">
  <div class="workspace">
    <div class="stage">
      <section class="intro">
        <div class="intro-avatar" aria-hidden="true">✳</div>
        <div>
          <p class="intro-kicker">{SITE.role}</p>
          <p class="intro-text">
            I turn complex ideas into intuitive, user-centered interfaces — from
            research and wireframes to pixel-perfect designs ready for
            development. Based in {SITE.location}.
          </p>
          <a class="intro-more" href="/about-me">More about me →</a>
        </div>
      </section>

      <section class="icons" aria-label="Desktop">
        {
          icons.map((i) => (
            <a
              class="icon"
              href={i.href}
              data-pw={i.pw ? "1" : undefined}
              {...(i.ext ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="icon-glyph" aria-hidden="true">{i.emoji}</span>
              <span class="icon-label">{i.label}</span>
            </a>
          ))
        }
      </section>
    </div>

    <aside class="widgets" aria-label="Widgets">
      <div class="widget">
        <div class="widget-title">Choose a theme</div>
        <div class="swatches">
          <button class="sw" data-theme="" style="background:#b3c7dd" aria-label="Blue"></button>
          <button class="sw" data-theme="sand" style="background:#e7d3c6" aria-label="Sand"></button>
          <button class="sw" data-theme="green" style="background:#cfe0cd" aria-label="Green"></button>
          <button class="sw" data-theme="dark" style="background:#2b2f36" aria-label="Dark"></button>
        </div>
      </div>
      <div class="widget">
        <div class="widget-title">{SITE.location}</div>
        <div class="weather"><span class="temp">22°</span><span class="cond">Mostly clear</span></div>
      </div>
      <div class="widget">
        <div class="widget-title">Now building</div>
        <div class="np">
          <div class="np-art" aria-hidden="true">✳</div>
          <div>
            <div class="np-line">desluko.com</div>
            <div class="np-sub">Portfolio · v1</div>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<!-- Модалка-пароль (декоративна) -->
<div id="pw" class="pw-overlay" hidden transition:persist="pw">
  <div class="pw-card" role="dialog" aria-modal="true" aria-label="Locked Case Studies">
    <div class="pw-lock" aria-hidden="true">🔒</div>
    <h3>Locked · Case Studies</h3>
    <p>Enter the password to view these projects. Selected work is
      password-protected for clients. Recruiter or hiring manager? Just say hello:</p>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <input type="password" id="pwInput" placeholder="Password (optional demo)" />
    <div class="pw-actions">
      <button id="pwCancel" class="pw-btn">Cancel</button>
      <button id="pwUnlock" class="pw-btn pw-primary">Unlock</button>
    </div>
  </div>
</div>

<style>
  .desktop { position: fixed; inset: 0; z-index: 1; padding-top: 30px; padding-bottom: 84px; }
  .workspace { height: 100%; display: flex; justify-content: space-between; gap: 2rem; padding: 2.2rem 1.6rem 0; overflow: hidden; }
  .stage { max-width: 820px; width: 100%; }
  .intro { display: flex; gap: 1.1rem; max-width: 680px; margin: 1rem 0 2.5rem; }
  .intro-avatar { flex: none; width: 64px; height: 64px; border-radius: 14px; display: grid; place-items: center; background: var(--panel-strong); box-shadow: var(--shadow); font-size: 1.5rem; }
  .intro-kicker { font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); font-weight: 700; }
  .intro-text { margin-top: .4rem; font-size: .92rem; line-height: 1.5; color: var(--ink); max-width: 40ch; }
  .intro-more { display: inline-block; margin-top: .6rem; font-size: .8rem; font-weight: 600; color: var(--ink); border-bottom: 1px solid currentColor; }

  .icons { display: grid; grid-template-columns: repeat(4, 96px); gap: 1.6rem 1.2rem; }
  .icon { display: flex; flex-direction: column; align-items: center; gap: .5rem; text-align: center; color: var(--ink); background: none; border: 0; cursor: pointer; font: inherit; }
  .icon-glyph { width: 72px; height: 72px; display: grid; place-items: center; font-size: 2.4rem; border-radius: 18px; background: var(--panel); border: 1px solid var(--panel-border); box-shadow: var(--shadow); transition: transform .18s ease, box-shadow .18s ease; }
  .icon:hover .icon-glyph { transform: translateY(-4px) scale(1.04); box-shadow: 0 18px 44px rgba(23,37,66,.26); }
  .icon-label { font-size: .78rem; font-weight: 500; padding: 1px 8px; border-radius: 6px; background: var(--label-bg); color: var(--ink); }

  .widgets { width: 260px; flex: none; display: flex; flex-direction: column; gap: 1rem; }
  .widget { background: var(--panel-strong); border: 1px solid var(--panel-border); border-radius: 18px; padding: 1rem; box-shadow: var(--shadow); backdrop-filter: blur(20px); color: var(--ink); }
  .widget-title { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); font-weight: 700; }
  .swatches { display: flex; gap: .6rem; margin-top: .7rem; }
  .sw { width: 26px; height: 26px; border-radius: 50%; border: 2px solid rgba(255,255,255,.8); cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
  .weather { margin-top: .5rem; display: flex; align-items: baseline; gap: .6rem; }
  .temp { font-size: 2rem; font-weight: 300; }
  .cond { font-size: .8rem; color: var(--ink-soft); }
  .np { margin-top: .6rem; display: flex; align-items: center; gap: .7rem; }
  .np-art { width: 44px; height: 44px; border-radius: 10px; background: var(--wall); display: grid; place-items: center; color: #fff; }
  .np-line { font-weight: 600; font-size: .9rem; }
  .np-sub { font-size: .75rem; color: var(--ink-soft); }

  .pw-overlay { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; background: rgba(20,30,50,.35); backdrop-filter: blur(3px); }
  .pw-card { width: min(360px, 90vw); background: #fff; border-radius: 16px; padding: 1.6rem; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,.35); color: #1c2530; }
  .pw-lock { width: 40px; height: 40px; margin: 0 auto .8rem; display: grid; place-items: center; border-radius: 10px; background: #111; font-size: 1.1rem; }
  .pw-card h3 { font-size: 1rem; font-weight: 700; }
  .pw-card p { font-size: .8rem; line-height: 1.5; color: #55627a; margin: .5rem 0; }
  .pw-card a { font-size: .8rem; color: #1c2530; text-decoration: underline; }
  .pw-card input { width: 100%; margin-top: .9rem; padding: .6rem .8rem; border: 1px solid #d5dae2; border-radius: 10px; font: inherit; font-size: .9rem; }
  .pw-actions { display: flex; gap: .6rem; margin-top: 1rem; }
  .pw-btn { flex: 1; padding: .55rem; border-radius: 10px; border: 1px solid #d5dae2; background: #fff; font: inherit; font-size: .85rem; cursor: pointer; }
  .pw-primary { background: #111; color: #fff; border-color: #111; }

  @media (max-width: 760px) {
    .widgets { display: none; }
    .icons { grid-template-columns: repeat(3, 90px); }
  }
</style>
