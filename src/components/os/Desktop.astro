---
/**
 * Desktop — сам робочий стіл (іконки, віджети, інтро) + модалка-пароль.
 * Персистентний шар: присутній на КОЖНІЙ сторінці й видимий ПОЗАДУ вікон,
 * тому при відкритті кейсу стіл із папками лишається на місці (як у macOS).
 */
import { SITE, SOCIALS, NOWPLAYING } from "../../consts";
import AppIcon from "./AppIcon.astro";
import Spiral from "./Spiral.astro";

const social = (label: string) =>
  SOCIALS.find((s) => s.label === label)?.href ?? "#";

const icons = [
  { label: "Case Studies", type: "folder", href: "/projects", pw: true },
  { label: "About Me", type: "book", href: "/about-me" },
  { label: "Contact", type: "mail", href: "/contact" },
  { label: "Resume", type: "doc", href: `mailto:${SITE.email}`, ext: true },
  { label: "Photos", type: "camera", href: social("Instagram"), ext: true },
  { label: "Dribbble", type: "dribbble", href: social("Dribbble"), ext: true },
  { label: "Behance", type: "behance", href: social("Behance"), ext: true },
  { label: "LinkedIn", type: "linkedin", href: social("LinkedIn"), ext: true },
] as const;
---

<div class="desktop" transition:persist="desktop">
  <div class="workspace">
    <div class="stage">
      <section class="intro">
        <div class="intro-avatar" aria-hidden="true">
          <Spiral size={34} stroke="var(--ink)" />
        </div>
        <div>
          <p class="intro-kicker">{SITE.role}</p>
          <p class="intro-text">
            I turn complex ideas into intuitive, user-centered interfaces — from
            research and wireframes to pixel-perfect designs ready for
            development. Based in {SITE.location}.
          </p>
          <a class="intro-more" href="/about-me">More about me →</a>
        </div>
      </section>

      <section class="icons" aria-label="Desktop">
        {
          icons.map((i, idx) => (
            <a
              class="icon"
              href={i.href}
              data-key={i.label}
              data-pw={i.pw ? "1" : undefined}
              style={`left:${(idx % 4) * 112}px;top:${Math.floor(idx / 4) * 132}px`}
              {...(i.ext ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <AppIcon type={i.type} />
              <span class="icon-label">{i.label}</span>
            </a>
          ))
        }
      </section>
    </div>

    <aside class="widgets" aria-label="Widgets">
      <div class="widget">
        <div class="widget-title">Choose a theme</div>
        <div class="swatches">
          <button class="sw" data-theme="" style="background:#b3c7dd" aria-label="Blue"></button>
          <button class="sw" data-theme="sand" style="background:#e7d3c6" aria-label="Sand"></button>
          <button class="sw" data-theme="green" style="background:#cfe0cd" aria-label="Green"></button>
          <button class="sw" data-theme="dark" style="background:#2b2f36" aria-label="Dark"></button>
        </div>
      </div>
      <div class="widget">
        <div class="widget-title">{SITE.location}</div>
        <div class="weather"><span class="temp">22°</span><span class="cond">Mostly clear</span></div>
      </div>
      <div class="widget">
        <div class="widget-title">Now Playing</div>
        <div class="np">
          <button class="np-play" id="npPlay" aria-label="Play / pause">
            <span class="np-ico" id="npIco">▶</span>
          </button>
          <div class="np-meta">
            <div class="np-line">{NOWPLAYING.title}</div>
            <div class="np-sub">{NOWPLAYING.artist}</div>
            <div class="np-bar" id="npBar"><div class="np-fill" id="npFill"></div></div>
          </div>
        </div>
        <audio id="npAudio" src={NOWPLAYING.src} preload="none"></audio>
      </div>
    </aside>
  </div>
</div>

<!-- Рамка виділення (rubber-band) -->
<div id="marquee" class="marquee" hidden transition:persist="marquee"></div>

<!-- Підказка-лічильник виділення -->
<div id="selpill" class="selpill" hidden transition:persist="selpill">
  <span id="selcount">0</span> selected · drag to move
</div>

<!-- Контекстне меню виділення -->
<div id="selctx" class="ctx" hidden transition:persist="selctx">
  <button class="ctx-item" data-action="tidy">Tidy up selection</button>
  <button class="ctx-item" data-action="deselect">Deselect all</button>
</div>

<!-- Контекстне меню (права кнопка на столі) -->
<div id="ctx" class="ctx" hidden transition:persist="ctx">
  <button class="ctx-item" data-action="about">About This Mac</button>
  <button class="ctx-item" data-action="theme">Change theme</button>
  <button class="ctx-item" data-action="cleanup">Clean up icons</button>
</div>

<!-- About This Mac -->
<div id="about-mac" class="am-overlay" hidden transition:persist="about">
  <div class="am-card" role="dialog" aria-modal="true" aria-label="About this Mac">
    <div class="am-logo"><Spiral size={54} stroke="#fff" width={2} /></div>
    <h3>{SITE.name}</h3>
    <p class="am-role">{SITE.role}</p>
    <dl class="am-specs">
      <div><dt>Location</dt><dd>{SITE.location}</dd></div>
      <div><dt>Focus</dt><dd>UX/UI · Web · Product · App</dd></div>
      <div><dt>Tools</dt><dd>Figma · Webflow · Framer</dd></div>
      <div><dt>Site</dt><dd>Built with Astro + Tailwind</dd></div>
    </dl>
    <button class="am-close" id="amClose">OK</button>
  </div>
</div>

<!-- Модалка-пароль (декоративна) -->
<div id="pw" class="pw-overlay" hidden transition:persist="pw">
  <div class="pw-card" role="dialog" aria-modal="true" aria-label="Locked Case Studies">
    <div class="pw-lock" aria-hidden="true">🔒</div>
    <h3>Locked · Case Studies</h3>
    <p>Enter the password to view these projects. Selected work is
      password-protected for clients. Recruiter or hiring manager? Just say hello:</p>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <input type="password" id="pwInput" placeholder="Password (optional demo)" />
    <div class="pw-actions">
      <button id="pwCancel" class="pw-btn">Cancel</button>
      <button id="pwUnlock" class="pw-btn pw-primary">Unlock</button>
    </div>
  </div>
</div>

<style>
  .desktop { position: fixed; inset: 0; z-index: 1; padding-top: 30px; padding-bottom: 84px; }
  .workspace { height: 100%; display: flex; align-items: center; justify-content: center; padding: 0 1.6rem; overflow: hidden; }
  .stage { max-width: 680px; }
  .intro { display: flex; gap: 1.1rem; max-width: 680px; margin: 1rem 0 2.5rem; }
  .intro-avatar { flex: none; width: 64px; height: 64px; border-radius: 14px; display: grid; place-items: center; background: var(--panel-strong); box-shadow: var(--shadow); font-size: 1.5rem; }
  .intro-kicker { font-size: .7rem; letter-spacing: .2em; text-transform: uppercase; color: var(--ink-soft); font-weight: 700; }
  .intro-text { margin-top: .4rem; font-size: .92rem; line-height: 1.5; color: var(--ink); max-width: 40ch; }
  .intro-more { display: inline-block; margin-top: .6rem; font-size: .8rem; font-weight: 600; color: var(--ink); border-bottom: 1px solid currentColor; }

  .icons { position: relative; width: 448px; max-width: 100%; height: 264px; }
  .icon { position: absolute; width: 96px; display: flex; flex-direction: column; align-items: center; gap: .5rem; text-align: center; color: var(--ink); background: none; border: 0; cursor: grab; font: inherit; touch-action: none; user-select: none; }
  .icon:active { cursor: grabbing; }
  .icon::before { content: ""; position: absolute; inset: -8px -6px -6px; border-radius: 16px; z-index: -1; transition: background .12s ease; }
  .icon.selected::before { background: rgba(74,144,226,.22); box-shadow: inset 0 0 0 1px rgba(74,144,226,.6); }
  .icon.selected .icon-label { background: rgba(74,144,226,.9); color: #fff; }

  .marquee { position: fixed; z-index: 15; border: 1px solid rgba(74,144,226,.9); background: rgba(74,144,226,.16); border-radius: 2px; pointer-events: none; }
  .selpill { position: fixed; z-index: 30; left: 50%; bottom: 76px; transform: translateX(-50%); padding: 6px 14px; border-radius: 999px; background: rgba(74,144,226,.92); color: #fff; font-size: .78rem; font-weight: 500; box-shadow: 0 6px 20px rgba(23,37,66,.3); pointer-events: none; }
  .selpill span { font-weight: 700; }
  .icon:hover :global(.app-tile) { transform: translateY(-5px) scale(1.05); box-shadow: 0 20px 46px rgba(23,37,66,.3), inset 0 1px 0 rgba(255,255,255,.4); }
  .icon:active :global(.app-tile) { transform: translateY(-1px) scale(.99); }
  .icon-label { font-size: .78rem; font-weight: 500; padding: 1px 8px; border-radius: 6px; background: var(--label-bg); color: var(--ink); }

  .widgets { position: absolute; top: 44px; right: 1.6rem; width: 260px; display: flex; flex-direction: column; gap: 1rem; }
  .widget { background: var(--panel-strong); border: 1px solid var(--panel-border); border-radius: 18px; padding: 1rem; box-shadow: var(--shadow); backdrop-filter: blur(20px); color: var(--ink); }
  .widget-title { font-size: .68rem; letter-spacing: .16em; text-transform: uppercase; color: var(--ink-soft); font-weight: 700; }
  .swatches { display: flex; gap: .6rem; margin-top: .7rem; }
  .sw { width: 26px; height: 26px; border-radius: 50%; border: 2px solid rgba(255,255,255,.8); cursor: pointer; box-shadow: 0 1px 4px rgba(0,0,0,.15); }
  .weather { margin-top: .5rem; display: flex; align-items: baseline; gap: .6rem; }
  .temp { font-size: 2rem; font-weight: 300; }
  .cond { font-size: .8rem; color: var(--ink-soft); }
  .np { margin-top: .6rem; display: flex; align-items: center; gap: .7rem; }
  .np-play { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 0; cursor: pointer; background: linear-gradient(160deg, #6f88ae, #47597c); color: #fff; display: grid; place-items: center; font-size: .85rem; box-shadow: 0 4px 12px rgba(23,37,66,.25); transition: transform .15s; }
  .np-play:hover { transform: scale(1.06); }
  .np-meta { flex: 1; min-width: 0; }
  .np-line { font-weight: 600; font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .np-sub { font-size: .75rem; color: var(--ink-soft); }
  .np-bar { margin-top: 6px; height: 4px; border-radius: 2px; background: var(--panel); cursor: pointer; overflow: hidden; }
  .np-fill { height: 100%; width: 0; background: var(--ink-soft); border-radius: 2px; transition: width .1s linear; }

  .ctx { position: fixed; z-index: 210; min-width: 180px; padding: 6px; background: var(--panel-strong); border: 1px solid var(--panel-border); border-radius: 12px; box-shadow: 0 20px 60px rgba(23,37,66,.32); backdrop-filter: blur(24px); }
  .ctx-item { display: block; width: 100%; text-align: left; padding: 8px 12px; border: 0; background: none; border-radius: 8px; font: inherit; font-size: .85rem; color: var(--ink); cursor: pointer; }
  .ctx-item:hover { background: var(--panel); }

  .am-overlay { position: fixed; inset: 0; z-index: 220; display: grid; place-items: center; background: rgba(20,30,50,.35); backdrop-filter: blur(4px); }
  .am-card { width: min(340px, 90vw); padding: 2rem 1.6rem; text-align: center; background: var(--panel-strong); border: 1px solid var(--panel-border); border-radius: 18px; box-shadow: 0 30px 80px rgba(0,0,0,.3); backdrop-filter: blur(30px); color: var(--ink); }
  .am-logo { width: 84px; height: 84px; margin: 0 auto 1rem; display: grid; place-items: center; border-radius: 20px; background: var(--wall); }
  .am-card h3 { font-size: 1.15rem; font-weight: 700; }
  .am-role { font-size: .72rem; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); margin-top: .2rem; }
  .am-specs { margin: 1.2rem 0; text-align: left; font-size: .85rem; }
  .am-specs > div { display: flex; justify-content: space-between; gap: 1rem; padding: 6px 0; border-bottom: 1px solid var(--panel-border); }
  .am-specs dt { color: var(--ink-soft); }
  .am-specs dd { color: var(--ink); font-weight: 500; }
  .am-close { padding: .5rem 1.6rem; border-radius: 10px; border: 0; background: var(--ink); color: var(--panel-strong); font: inherit; font-size: .85rem; font-weight: 600; cursor: pointer; }

  .pw-overlay { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; background: rgba(20,30,50,.35); backdrop-filter: blur(3px); }
  .pw-card { width: min(360px, 90vw); background: #fff; border-radius: 16px; padding: 1.6rem; text-align: center; box-shadow: 0 30px 80px rgba(0,0,0,.35); color: #1c2530; }
  .pw-lock { width: 40px; height: 40px; margin: 0 auto .8rem; display: grid; place-items: center; border-radius: 10px; background: #111; font-size: 1.1rem; }
  .pw-card h3 { font-size: 1rem; font-weight: 700; }
  .pw-card p { font-size: .8rem; line-height: 1.5; color: #55627a; margin: .5rem 0; }
  .pw-card a { font-size: .8rem; color: #1c2530; text-decoration: underline; }
  .pw-card input { width: 100%; margin-top: .9rem; padding: .6rem .8rem; border: 1px solid #d5dae2; border-radius: 10px; font: inherit; font-size: .9rem; }
  .pw-actions { display: flex; gap: .6rem; margin-top: 1rem; }
  .pw-btn { flex: 1; padding: .55rem; border-radius: 10px; border: 1px solid #d5dae2; background: #fff; font: inherit; font-size: .85rem; cursor: pointer; }
  .pw-primary { background: #111; color: #fff; border-color: #111; }

  @media (max-width: 760px) {
    .widgets { display: none; }
    .icons { grid-template-columns: repeat(3, 90px); }
  }
</style>
