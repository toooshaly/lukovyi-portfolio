---
/**
 * Spotlight — пошук у стилі macOS (⌘K / Ctrl+K). Персистентний overlay.
 * Стрілки — навігація, Enter — відкрити, Esc — закрити.
 */
import { getCollection } from "astro:content";

const projects = (
  await getCollection("projects", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => a.data.order - b.data.order);

const items = [
  ...projects.map((p) => ({
    title: p.data.title,
    sub: p.data.category,
    href: `/projects/${p.id}`,
  })),
  { title: "Case Studies", sub: "All projects", href: "/projects" },
  { title: "About Me", sub: "Page", href: "/about-me" },
  { title: "Contact", sub: "Page", href: "/contact" },
];
---

<div id="spotlight" class="sl" hidden transition:persist="spotlight">
  <div class="sl-box" role="dialog" aria-modal="true" aria-label="Spotlight search">
    <div class="sl-head">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line>
      </svg>
      <input id="sl-input" type="text" placeholder="Search projects & pages…" autocomplete="off" spellcheck="false" />
      <kbd>esc</kbd>
    </div>
    <ul id="sl-list">
      {
        items.map((it, i) => (
          <li
            class="sl-item"
            data-href={it.href}
            data-text={(it.title + " " + it.sub).toLowerCase()}
            data-i={i}
          >
            <span class="sl-t">{it.title}</span>
            <span class="sl-s">{it.sub}</span>
          </li>
        ))
      }
    </ul>
    <div id="sl-empty" class="sl-empty" hidden>No results</div>
  </div>
</div>

<style>
  .sl { position: fixed; inset: 0; z-index: 300; display: grid; place-items: start center; padding-top: 14vh; background: rgba(20, 30, 50, 0.28); backdrop-filter: blur(4px); }
  .sl-box { width: min(560px, 92vw); background: var(--panel-strong); border: 1px solid var(--panel-border); border-radius: 16px; box-shadow: 0 30px 90px rgba(23, 37, 66, 0.4); backdrop-filter: blur(30px); overflow: hidden; }
  .sl-head { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--panel-border); color: var(--ink-soft); }
  #sl-input { flex: 1; border: 0; background: none; font: inherit; font-size: 1.05rem; color: var(--ink); outline: none; }
  .sl-head kbd { font-size: 0.65rem; padding: 2px 6px; border-radius: 5px; background: var(--panel); border: 1px solid var(--panel-border); color: var(--ink-soft); }
  #sl-list { max-height: 46vh; overflow-y: auto; padding: 6px; }
  .sl-item { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 10px 12px; border-radius: 10px; cursor: pointer; }
  .sl-item.is-active, .sl-item:hover { background: var(--panel); }
  .sl-t { font-weight: 600; color: var(--ink); font-size: 0.95rem; }
  .sl-s { font-size: 0.75rem; color: var(--ink-soft); }
  .sl-empty { padding: 20px; text-align: center; color: var(--ink-soft); font-size: 0.9rem; }
</style>

<script>
  import { navigate } from "astro:transitions/client";

  function initSpotlight() {
    const w = window as any;
    if (w.__spotlightInit) return;
    w.__spotlightInit = true;

    const sl = () => document.getElementById("spotlight");
    const input = () => document.getElementById("sl-input") as HTMLInputElement | null;
    const items = () => Array.from(document.querySelectorAll<HTMLElement>(".sl-item"));
    let active = 0;

    function visible() {
      return items().filter((el) => el.style.display !== "none");
    }
    function setActive(i: number) {
      const vis = visible();
      if (!vis.length) return;
      active = (i + vis.length) % vis.length;
      items().forEach((el) => el.classList.remove("is-active"));
      vis[active].classList.add("is-active");
      vis[active].scrollIntoView({ block: "nearest" });
    }
    function open() {
      const el = sl();
      if (!el) return;
      el.hidden = false;
      const inp = input();
      if (inp) { inp.value = ""; inp.focus(); }
      filter("");
    }
    function close() { const el = sl(); if (el) el.hidden = true; }
    function isOpen() { return sl() && !sl()!.hidden; }
    function filter(q: string) {
      const query = q.trim().toLowerCase();
      let shown = 0;
      items().forEach((el) => {
        const match = !query || (el.dataset.text || "").includes(query);
        el.style.display = match ? "" : "none";
        if (match) shown++;
      });
      const empty = document.getElementById("sl-empty");
      if (empty) empty.hidden = shown > 0;
      setActive(0);
    }
    function go() {
      const vis = visible();
      const el = vis[active];
      if (el?.dataset.href) { close(); navigate(el.dataset.href); }
    }

    document.addEventListener("keydown", (e) => {
      const cmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k";
      if (cmdK) { e.preventDefault(); isOpen() ? close() : open(); return; }
      if (!isOpen()) return;
      if (e.key === "Escape") { e.preventDefault(); close(); }
      else if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Enter") { e.preventDefault(); go(); }
    });

    // делегування (елементи персистентні)
    document.addEventListener("input", (e) => {
      if ((e.target as HTMLElement)?.id === "sl-input") filter((e.target as HTMLInputElement).value);
    });
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t?.closest?.("[data-spotlight]")) { open(); return; }
      const item = t?.closest?.(".sl-item") as HTMLElement | null;
      if (item?.dataset.href) { close(); navigate(item.dataset.href); }
      else if (t?.id === "spotlight") close();
    });
  }

  initSpotlight();
  document.addEventListener("astro:page-load", initSpotlight);
</script>
