---
/**
 * AppIcon — крафтова macOS-плитка (Big Sur-стиль): градієнтний rounded-square
 * + білий гліф. Замінює емодзі-плейсхолдери на охайні іконки.
 */
interface Props {
  type:
    | "folder"
    | "book"
    | "mail"
    | "doc"
    | "camera"
    | "dribbble"
    | "behance"
    | "linkedin";
}
const { type } = Astro.props;

const grads: Record<string, [string, string]> = {
  folder: ["#5aa2ea", "#2f6fb0"],
  book: ["#9a86ff", "#6b5bd6"],
  mail: ["#41d07a", "#2aa14a"],
  doc: ["#ffb057", "#f2792b"],
  camera: ["#ff86b3", "#ff4f8b"],
  dribbble: ["#f06ba0", "#d63384"],
  behance: ["#4a8bff", "#0057e7"],
  linkedin: ["#3a9be0", "#0a66c2"],
};
const [g1, g2] = grads[type];
---

<span class="app-tile" style={`--g1:${g1};--g2:${g2}`}>
  <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8"
    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {type === "folder" && (
      <path d="M3 8a2 2 0 0 1 2-2h3.5l1.8 2H19a2 2 0 0 1 2 2v6.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8z" />
    )}
    {type === "book" && (
      <>
        <rect x="5.5" y="4" width="13" height="16" rx="1.8" />
        <line x1="9.2" y1="4" x2="9.2" y2="20" />
      </>
    )}
    {type === "mail" && (
      <>
        <rect x="3.5" y="6" width="17" height="12" rx="2.2" />
        <path d="M4 8l8 5.5L20 8" />
      </>
    )}
    {type === "doc" && (
      <>
        <rect x="6" y="3.5" width="12" height="17" rx="2" />
        <line x1="9" y1="9" x2="15" y2="9" />
        <line x1="9" y1="12.5" x2="15" y2="12.5" />
        <line x1="9" y1="16" x2="13" y2="16" />
      </>
    )}
    {type === "camera" && (
      <>
        <rect x="3.5" y="7.5" width="17" height="11.5" rx="2.4" />
        <rect x="8.5" y="4.5" width="7" height="3.5" rx="1.2" />
        <circle cx="12" cy="13.2" r="3.2" />
      </>
    )}
    {type === "dribbble" && (
      <>
        <circle cx="12" cy="12" r="8.4" />
        <path d="M5 9.5c4.6 1 9.2.4 13.4-2M4.6 14.8c3.5-3 8.4-3.2 12.4-.4M9.4 4.2c3.4 4 5.2 8.8 5.6 14.6" />
      </>
    )}
    {type === "behance" && (
      <text x="12" y="16" text-anchor="middle" font-size="11" font-weight="800"
        fill="#fff" stroke="none" font-family="system-ui, sans-serif">Bē</text>
    )}
    {type === "linkedin" && (
      <text x="12" y="16.5" text-anchor="middle" font-size="11" font-weight="800"
        fill="#fff" stroke="none" font-family="system-ui, sans-serif">in</text>
    )}
  </svg>
</span>

<style>
  .app-tile {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: linear-gradient(160deg, var(--g1), var(--g2));
    box-shadow:
      var(--shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .app-tile svg {
    width: 40px;
    height: 40px;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.18));
  }
</style>
