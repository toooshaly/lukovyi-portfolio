---
/**
 * Spiral — фірмовий спіральний знак (аватар/лого), у дусі референсу.
 * Path рахується на збірці, тож немає важкого хардкоду.
 */
interface Props {
  size?: number;
  stroke?: string;
  width?: number;
  class?: string;
}
const { size = 40, stroke = "currentColor", width = 1.7, class: className = "" } =
  Astro.props;

const cx = 24;
const cy = 24;
const turns = 3.1;
const steps = 170;
let d = "";
for (let i = 0; i <= steps; i++) {
  const t = (i / steps) * turns * 2 * Math.PI;
  const rr = (2.2 * t) / (2 * Math.PI) * 2.0;
  const x = cx + rr * Math.cos(t);
  const y = cy + rr * Math.sin(t);
  d += (i ? "L" : "M") + x.toFixed(2) + " " + y.toFixed(2) + " ";
}
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  class={className}
  aria-hidden="true"
>
  <path
    d={d.trim()}
    stroke={stroke}
    stroke-width={width}
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
