---
/**
 * SectionMarker — моно-лейбл секції з акцентною крапкою (1:1 з Figma "section-marker").
 * Крапка бере колір із --surface-accent, тож автоматично тематична (gold/orange).
 * Текст: через проп `label` або <slot>. Позиціонування — через `class`/`style` ззовні.
 */
interface Props {
  label?: string;
  class?: string;
}
const { label, class: className, ...rest } = Astro.props;
---

<span class:list={["section-marker", "label", className]} {...rest}>
  <span class="dot" aria-hidden="true"></span>{label}<slot />
</span>

<style>
  .section-marker {
    color: var(--text-accent);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    line-height: 1;
  }
  .dot {
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: currentColor;
    display: inline-block;
    flex-shrink: 0;
  }
</style>
