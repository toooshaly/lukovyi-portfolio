---
/**
 * ProjectCard — картка кейсу в списку проєктів (home + /projects).
 * Дані приходять з колекції контенту (крок 4). Якщо обкладинки ще нема —
 * показуємо охайний плейсхолдер, щоб верстка не «ламалась».
 */
import { Image } from "astro:assets";
import MonoLabel from "./MonoLabel.astro";

interface Props {
  title: string;
  category: string;
  href: string;
  /** Порядковий номер для моно-нумерації ("01", "02"...) */
  num?: string;
  /** Мітка статусу, напр. "SOON" */
  status?: string;
  /** Обкладинка (імпортоване зображення). Необов'язкова. */
  cover?: ImageMetadata;
  coverAlt?: string;
}
const { title, category, href, num, status, cover, coverAlt = "" } =
  Astro.props;

const isSoon = !!status;
---

<a
  href={href}
  aria-disabled={isSoon ? "true" : undefined}
  class:list={[
    "group block",
    isSoon && "pointer-events-none opacity-60",
  ]}
>
  <!-- Обкладинка -->
  <div
    class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-line bg-ink-soft"
  >
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt || `${title} — ${category}`}
          widths={[480, 800, 1200]}
          sizes="(max-width: 768px) 100vw, 50vw"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div
          class="flex h-full w-full items-center justify-center bg-gradient-to-br from-ink-soft to-ink"
        >
          <span class="font-mono text-xs uppercase tracking-widest text-muted-dark">
            {title}
          </span>
        </div>
      )
    }

    {
      status && (
        <span class="absolute right-4 top-4 rounded-full bg-accent px-3 py-1 font-mono text-[10px] font-medium uppercase tracking-widest text-accent-ink">
          {status}
        </span>
      )
    }
  </div>

  <!-- Підпис -->
  <div class="mt-4 flex items-start justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        {num && <MonoLabel>{num}</MonoLabel>}
        <MonoLabel>{category}</MonoLabel>
      </div>
      <h3
        class="mt-2 text-2xl font-medium text-paper transition-colors group-hover:text-accent"
      >
        {title}
      </h3>
    </div>
    <span
      class="mt-1 text-muted transition-transform duration-300 group-hover:translate-x-1 group-hover:text-accent"
      aria-hidden="true">→</span
    >
  </div>
</a>
