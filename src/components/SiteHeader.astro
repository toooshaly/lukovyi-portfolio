---
/**
 * SiteHeader — верхня навігація (sticky).
 * Нумеровані моно-лінки як на поточному сайті + активний стан.
 * Мобільне меню — на нативному <details>, без JS (ціль: мінімум JS).
 */
import Container from "./Container.astro";
import Button from "./Button.astro";
import { SITE, NAV } from "../consts";

// Активний пункт: нормалізуємо слеш у кінці
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, "") || "/";
  return h === "/" ? path === "/" : path === h || path.startsWith(h + "/");
};
---

<header
  class="sticky top-0 z-50 border-b border-line bg-ink/80 backdrop-blur-md"
>
  <Container class="flex items-center justify-between py-4">
    <a
      href="/"
      class="group flex items-baseline gap-2"
      aria-label={`${SITE.name} — home`}
    >
      <span class="text-lg font-semibold tracking-tight text-paper"
        >{SITE.name}</span
      >
      <span class="hidden font-mono text-xs text-muted sm:inline"
        >— {SITE.role}</span
      >
    </a>

    <!-- Десктоп-навігація -->
    <nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "group flex items-center gap-1.5 text-sm transition-colors",
              isActive(item.href)
                ? "text-accent"
                : "text-paper hover:text-accent",
            ]}
          >
            <span class="font-mono text-xs text-muted group-hover:text-accent">
              {item.num}
            </span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden md:block">
      <Button href="/contact" variant="secondary">Let's chat</Button>
    </div>

    <!-- Мобільне меню (нативний disclosure, без JS) -->
    <details class="group relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 font-mono text-xs uppercase tracking-widest text-paper marker:hidden [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav
        aria-label="Mobile"
        class="absolute right-0 mt-4 flex w-56 flex-col gap-1 rounded-2xl border border-line bg-ink-soft p-3 shadow-xl"
      >
        {
          NAV.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "flex items-center gap-2 rounded-xl px-3 py-2 text-sm",
                isActive(item.href)
                  ? "bg-ink text-accent"
                  : "text-paper hover:bg-ink",
              ]}
            >
              <span class="font-mono text-xs text-muted">{item.num}</span>
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </Container>
</header>
