---
import OSLayout from "../layouts/OSLayout.astro";
import WindowFrame from "../components/os/WindowFrame.astro";
import Container from "../components/Container.astro";
import MonoLabel from "../components/MonoLabel.astro";
import Button from "../components/Button.astro";
import { SITE, SOCIALS } from "../consts";

const interests = ["#VideoEnthusiast", "#PhotographyLover"];
---

<OSLayout
  title={`About — ${SITE.name}`}
  description="Anton Lukovyi — freelance UX/UI designer and Webflow developer helping businesses grow through design."
>
  <WindowFrame title="About Me">
    <Container class="py-16 sm:py-24">
    <MonoLabel>About me</MonoLabel>
    <h1 class="mt-4 max-w-4xl text-5xl font-medium leading-tight text-paper sm:text-6xl">
      Hello, my name is {SITE.name}
    </h1>

    <div class="mt-12 grid gap-12 md:grid-cols-3">
      <div class="space-y-6 text-lg leading-relaxed text-muted md:col-span-2">
        <p>
          I'm a freelance UX/UI designer and Webflow developer passionate about
          helping businesses grow through exceptional design. My journey began
          over two years ago, focused on creating standout digital experiences.
        </p>
        <p>
          I specialize in bespoke website design and development — serving
          government institutions, startups, and established businesses. My work
          spans SaaS dashboards and e-commerce platforms.
        </p>
        <p class="text-paper">
          Design is about more than aesthetics — it's about creating meaningful
          connections between businesses and their audiences.
        </p>
      </div>

      <aside class="space-y-8">
        <div>
          <MonoLabel>Based in</MonoLabel>
          <p class="mt-2 text-paper">{SITE.location}</p>
        </div>
        <div>
          <MonoLabel>Interests</MonoLabel>
          <ul class="mt-2 space-y-1">
            {interests.map((t) => <li class="text-paper">{t}</li>)}
          </ul>
        </div>
        <div>
          <MonoLabel>Find me on</MonoLabel>
          <ul class="mt-2 space-y-1">
            {
              SOCIALS.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-paper transition-colors hover:text-accent"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    <div class="mt-16 flex flex-wrap gap-4">
      <Button href="/projects" variant="primary">My work</Button>
      <Button href="/contact" variant="secondary">Get in touch</Button>
    </div>
    </Container>
  </WindowFrame>
</OSLayout>
