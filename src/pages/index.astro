---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
---

<BaseLayout title={`${SITE.name} — ${SITE.role}`}>
  <main class="mx-auto max-w-5xl px-6 py-24">
    <p class="font-mono text-sm uppercase tracking-widest text-accent">
      Design tokens smoke test
    </p>
    <h1 class="mt-4 text-5xl font-medium text-paper">
      Hello, my name is {SITE.name}
    </h1>
    <p class="mt-4 max-w-xl text-lg text-muted">{SITE.role}</p>
    <a
      href="/contact"
      class="mt-8 inline-block rounded-full bg-accent px-6 py-3 font-mono text-sm font-medium text-accent-ink"
    >
      Contact with me
    </a>
  </main>
</BaseLayout>
