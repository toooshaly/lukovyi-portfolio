---
import OSLayout from "../layouts/OSLayout.astro";
import { SITE } from "../consts";
---

<OSLayout>
  <!-- Екран блокування (лише на головній; стіл рендерить OSLayout позаду) -->
  <div id="lock" class="lock">
    <div class="lock-top">
      <div class="lock-date" id="lockDate">—</div>
      <div class="lock-clock" id="lockClock">00:00</div>
    </div>
    <div class="lock-user">
      <div class="avatar" aria-hidden="true">✳</div>
      <div class="lock-name">{SITE.name}</div>
      <div class="lock-role">{SITE.role}</div>
      <button class="unlock-btn" id="unlockBtn">🔓 Click to unlock</button>
    </div>
    <div class="lock-hint">Click anywhere to unlock</div>
  </div>
</OSLayout>

<style>
  .lock { position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column; align-items: center; justify-content: space-between; padding: 3.5rem 0 2rem; background: var(--wall); cursor: pointer; transition: opacity .6s ease, transform .6s ease, filter .6s ease; }
  .lock.is-open { opacity: 0; transform: scale(1.04); filter: blur(6px); pointer-events: none; }
  .lock-top { text-align: center; color: #eef3fb; }
  .lock-date { font-size: .95rem; font-weight: 600; opacity: .9; }
  .lock-clock { font-size: clamp(5rem, 16vw, 12rem); font-weight: 300; line-height: .9; letter-spacing: -.03em; transform: scaleY(1.35); transform-origin: top center; margin-top: .6rem; text-shadow: 0 2px 30px rgba(23,37,66,.25); }
  .lock-user { text-align: center; color: #f3f6fb; }
  .avatar { width: 68px; height: 68px; margin: 0 auto .75rem; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.25); backdrop-filter: blur(8px); font-size: 1.6rem; }
  .lock-name { font-size: 1.15rem; font-weight: 700; }
  .lock-role { font-size: .7rem; letter-spacing: .22em; text-transform: uppercase; opacity: .85; margin-top: .2rem; }
  .unlock-btn { margin-top: 1rem; padding: .5rem 1.1rem; border: 0; border-radius: 999px; background: rgba(255,255,255,.28); color: #fff; font: inherit; font-size: .85rem; cursor: pointer; backdrop-filter: blur(8px); }
  .unlock-btn:hover { background: rgba(255,255,255,.42); }
  .lock-hint { color: rgba(255,255,255,.75); font-size: .7rem; letter-spacing: .24em; text-transform: uppercase; }
  @media (max-width: 760px) { .lock-clock { transform: scaleY(1.2); } }
</style>

<script>
  function initLock() {
    const lock = document.getElementById("lock");
    if (!lock) return;
    function unlock() {
      lock!.classList.add("is-open");
      sessionStorage.setItem("unlocked", "1");
      window.setTimeout(() => { lock!.style.display = "none"; }, 650);
    }
    if (sessionStorage.getItem("unlocked") === "1") {
      lock.style.display = "none";
    } else {
      lock.style.display = "";
      lock.classList.remove("is-open");
      lock.addEventListener("click", unlock, { once: true });
    }
  }
  initLock();
  document.addEventListener("astro:page-load", initLock);
</script>
