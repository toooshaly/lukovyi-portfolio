---
/**
 * Home — 1:1 з Figma "Portfolio 2.0" (frame Main page — black/white).
 * Hero (LUKOVYI PORTFOLIO, відео-фон) → About-тизер → SELECT WORK → 3 роботи.
 */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import ArrowUpRight from "../components/icons/ArrowUpRight.astro";
import Plus from "../components/icons/Plus.astro";
import SectionMarker from "../components/SectionMarker.astro";
import WorkCard from "../components/WorkCard.astro";
import { clientWork } from "../data/work";
import headshot from "../assets/about/headshot.png";
import heroImg from "../assets/hero/hero.jpg";

const chips = ["UX/UI", "Product", "Design System", "AI Workflow"];
---

<BaseLayout title={`${SITE.name} — ${SITE.role}`}>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-bg">
      <Image src={heroImg} alt="" widths={[768, 1200, 1800, 2400]} sizes="100vw" class="hero-media" loading="eager" fetchpriority="high" />
      <div class="hero-scrim"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-wordwrap">
        <p class="hero-intro label">
          UX/UI/Product Designer with decent taste working across
          <span class="hl" data-rotator>Product</span>
        </p>
        <div class="hero-cr label">{SITE.name}<br />Portfolio {new Date().getFullYear()} ©</div>
        <h1 class="hero-word display" aria-label="Lukovyi Portfolio">
        <span class="hw-row r1">
          <span>L</span>
          <span>KO</span>
        </span>
        <span class="hw-row r2"><span class="hw-u">U</span><span>VYI</span></span>
        <span class="hw-row r3"><span>P</span><span>O</span><span>R</span><span>T</span><span>F</span><span>O</span><span>L</span><span>I</span><span>O</span></span>
        </h1>
      </div>

      <div class="hero-foot label">
        <span>52.62.10.00E — {SITE.location}</span>
        <span data-clock>--:--:--</span>
      </div>
    </div>
  </section>

  <!-- ================= ABOUT-ТИЗЕР ================= -->
  <section class="about-teaser">
    <span class="plus tl" aria-hidden="true"><Plus /></span><span class="plus tr" aria-hidden="true"><Plus /></span>
    <div class="at-grid">
      <SectionMarker label="Intro" style="flex-shrink:0;margin-top:6px" />
      <div class="at-head">
        <div class="at-word display">ABTM<span class="us" data-typing="E">E</span></div>
        <a href="/about-me" class="at-more label link-fx">Read more <ArrowUpRight /></a>
      </div>
      <div class="at-side">
        <div class="at-bio">
          <Image src={headshot} alt={SITE.name} width={120} height={120} class="at-avatar" />
          <p>I'm at my best when I get to stay close to the craft, combining a strategic view with hands-on execution.</p>
        </div>
        <ul class="at-chips label">
          {chips.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
    <span class="plus bl" aria-hidden="true"><Plus /></span><span class="plus br" aria-hidden="true"><Plus /></span>
  </section>

  <!-- ================= РОБОТИ (Selected) ================= -->
  <section class="works-sec" id="work">
    <div class="works">
      {clientWork.map((w) => <WorkCard {...w} />)}
    </div>
  </section>

  <script>
    // Одне слово, що циклічно змінюється (Product → Web → App → …) з ефектом
    // «дешифрування»: літери прокручуються й фіксуються зліва направо.
    (() => {
      const el = document.querySelector(".hero-intro [data-rotator]");
      if (!el) return;
      const words = ["Product", "Web", "App"];
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) { el.textContent = words[0]; return; }
      const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/#*<>";
      const rnd = () => chars[(Math.random() * chars.length) | 0];
      function scramble(text, dur) {
        const start = performance.now();
        const N = text.length;
        function tick(now) {
          const p = Math.min(1, (now - start) / dur);
          const revealed = Math.floor(p * N);
          let s = "";
          for (let i = 0; i < N; i++) s += i < revealed ? text[i] : rnd();
          el.textContent = s;
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = text;
        }
        requestAnimationFrame(tick);
      }
      let idx = 0;
      scramble(words[0], 650);
      setInterval(() => { idx = (idx + 1) % words.length; scramble(words[idx], 650); }, 2800);
    })();
  </script>

  <script>
    // Typing-ефект літери «E» після «ABTM»: набір → пауза → стирання → пауза → знову.
    (() => {
      const el = document.querySelector(".at-word [data-typing]");
      if (!el) return;
      const word = el.getAttribute("data-typing") || "E";
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) { el.textContent = word; return; }
      let i = word.length, dir = -1; // почати з повного слова, тоді стирати
      function step() {
        el.textContent = word.slice(0, i);
        if (dir === -1) {
          if (i > 0) { i--; setTimeout(step, 150); }
          else { dir = 1; setTimeout(step, 700); }
        } else {
          if (i < word.length) { i++; setTimeout(step, 230); }
          else { dir = -1; setTimeout(step, 1700); }
        }
      }
      setTimeout(step, 1700);
    })();
  </script>

  <script>
    // Проєкти: full-bleed → звуження в карточку (scale + скруглення) при доскролі ~до середини.
    // JS-драйв (працює в усіх браузерах, синхронно з Lenis-скролом).
    (() => {
      const cards = Array.from(document.querySelectorAll(".work-card"));
      if (!cards.length || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      let ticking = false;
      function update() {
        const vh = window.innerHeight;
        for (const card of cards) {
          const r = card.getBoundingClientRect();
          const p = Math.max(0, Math.min(1, (vh - r.top) / (vh * 0.5)));
          card.style.transform = "scale(" + (1 - 0.035 * p) + ")";
          card.style.borderRadius = 16 * p + "px";
        }
        ticking = false;
      }
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      update();
    })();
  </script>
</BaseLayout>

<style>
  /* ---------------- HERO ----------------
     Висота = пропорція Figma (1440×900 → 62.5vw), з підлогою 620px. Не
     залежить від висоти екрана; масштабується з шириною разом із wordmark. */
  .hero {
    position: relative;
    height: 100vh; height: 100dvh; /* герой займає всю висоту екрану на вході */
    min-height: 620px;
    margin-top: -88px; /* під sticky-навбар */
    overflow: hidden;
    color: var(--text-on-media);
  }
  .hero-bg { position: absolute; inset: 0; z-index: 0; background: var(--black); }
  .hero-media { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
  .hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,.15) 40%, rgba(0,0,0,.55)); }

  /* Wordmark вертикально по центру; мета-тексти — по кутах (absolute) */
  .hero-inner {
    position: relative; z-index: 1; height: 100%;
    display: grid; align-content: center; padding: 0 var(--pad-side);
  }
  /* Обгортка wordmark — точка відліку для інтро (1:1 з Figma: інтро зверху-праворуч,
     верх на рівні верху wordmark-рядка, правий край до краю контенту). */
  .hero-wordwrap { position: relative; }
  .hero-intro { position: absolute; top: 0; right: 0; width: 250px; text-align: left; color: rgba(255,255,255,.72); }
  .hero-intro .hl { color: #fff; }
  /* Слово-ротатор — окремим останнім рядком, щоб зміна довжини не «стрибала» */
  .hero-intro [data-rotator] { display: block; margin-top: 2px; }
  /* «ANTON LUKOVYI / PORTFOLIO 2026 ©» — зліва, на рівні другого рядка wordmark */
  .hero-cr { position: absolute; top: 33.33%; left: 0; color: rgba(255,255,255,.6); line-height: 1.5; }
  .hero-foot { position: absolute; left: var(--pad-side); right: var(--pad-side); bottom: var(--hero-pad-bottom); display: flex; justify-content: space-between; gap: 1rem; color: var(--gold-500); }

  .hero-word {
    position: relative; margin: 0; width: 100%;
    display: grid; gap: 0.7vw; color: #fff; /* міжрядковий відступ ≈ Figma 12px */
    --ux: 42%; /* спільна вісь X: стрілка (r1) і U (r2) стоять точно одна під одною */
  }
  /* Розмір від доступної ширини та довжини "PORTFOLIO" (9×~0.7em) — рядок
     рівно заповнює ширину на будь-якому екрані. */
  .hw-row { position: relative; display: flex; align-items: center; font-size: calc((100vw - var(--pad-side) * 2) / 6.5); line-height: 0.8; }
  .hw-row.r1 { justify-content: space-between; padding: 0 32% 0 22%; }
  .hw-row.r2 { justify-content: flex-end; padding-right: 2%; }
  .hw-row.r3 { justify-content: space-between; }
  /* стрілка й U — абсолютно на осі --ux (U точно під стрілкою) */
  .hw-u { position: absolute; left: var(--ux); top: 50%; transform: translate(-50%, -50%); }

  @media (max-width: 900px) {
    .hero { height: 100svh; min-height: 560px; }
    .hero-intro { position: static; width: auto; max-width: none; margin: 0 0 auto; }
    .hero-cr { display: none; }
    .hw-row { font-size: calc((100vw - var(--pad-side-mobile) * 2) / 6.8); }
    .hw-row.r1 { padding: 0 22% 0 14%; }
    .hero-word { --ux: 32%; }
  }

  /* ---------------- ABOUT-ТИЗЕР (full-bleed) ---------------- */
  .about-teaser { position: relative; padding: var(--at-pad-top) var(--pad-side) var(--at-pad-bottom); }
  /* Один ряд як у Figma: intro (лівий край) · ABT_M_ (відступ) · профіль (правий край).
     На широкому екрані intro лишається зліва, профіль тримається правого краю. */
  .at-grid { display: flex; align-items: flex-start; gap: 48px; }

  .at-head { margin-left: var(--at-word-indent); display: flex; flex-direction: column; gap: 24px; }
  .at-word { font-size: clamp(2.5rem, 8vw, 240px); line-height: 0.8; color: var(--text-primary); white-space: nowrap; }
  .at-word .us { color: var(--text-accent); }
  /* Курсор для typing-ефекту літери E після M */
  .at-word [data-typing] { border-right: 0.06em solid var(--text-accent); margin-left: 0.02em; }
  @media (prefers-reduced-motion: no-preference) {
    .at-word [data-typing] { animation: at-caret 1.05s step-end infinite; }
  }
  @keyframes at-caret { 0%, 100% { border-color: var(--text-accent); } 50% { border-color: transparent; } }
  .at-more { color: var(--text-accent); align-self: start; display: inline-flex; align-items: center; gap: 6px; }
  .at-more :global(svg) { width: 14px; height: 14px; }
  .at-more:hover { text-decoration: underline; }

  .at-side { margin-left: auto; flex-shrink: 0; width: 360px; display: grid; gap: 24px; }
  .at-bio { display: grid; grid-template-columns: 120px 1fr; gap: 24px; align-items: start; }
  .at-avatar { width: 120px; height: 120px; object-fit: cover; border-radius: 4px; }
  .at-bio p { margin: 0; color: var(--text-muted); font-size: 15px; line-height: 1.35; }
  .at-chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .at-chips li { border: 1px solid var(--border-subtle); border-radius: 999px; padding: 6px 16px; color: var(--text-muted); }

  @media (max-width: 1024px) {
    .at-grid { flex-direction: column; gap: 32px; }
    .at-head { margin-left: 0; }
    .at-side { margin-left: 0; width: 100%; max-width: 460px; }
  }


  /* ---------------- РОБОТИ (Selected) ---------------- */
  .works-sec { scroll-margin-top: 0; }
  .works { scroll-margin-top: 0; }

  /* Кутовий «+» у тизері About (базові стилі .plus — глобально) */
  .about-teaser .plus { color: var(--icon-muted); }
</style>
