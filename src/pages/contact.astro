---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE, SOCIALS } from "../consts";
---

<BaseLayout
  title={`Contact — ${SITE.name}`}
  description="Get in touch with Anton Lukovyi — freelance UX/UI designer. Available for new projects."
>
  <section class="wrap">
    <span class="mono idx">[ Contact ]</span>
    <h1 class="page-h">Let's<br />work</h1>
    <a href={`mailto:${SITE.email}`} class="big-mail">{SITE.email} <span class="sl">&gt;</span></a>
  </section>

  <section class="wrap grid">
    <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="form">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden"><label>Don't fill: <input name="bot-field" /></label></p>
      <label class="field"><span class="mono k">Name</span><input name="name" type="text" required placeholder="Your name" /></label>
      <label class="field"><span class="mono k">Email</span><input name="email" type="email" required placeholder="you@email.com" /></label>
      <label class="field"><span class="mono k">Message</span><textarea name="message" rows="4" required placeholder="Tell me about your project"></textarea></label>
      <button type="submit" class="submit mono">[ Send message &gt; ]</button>
    </form>

    <aside class="meta mono">
      <div class="row"><span class="k">Status</span><span class="v"><span class="dot"></span> Available</span></div>
      <div class="row"><span class="k">Based in</span><span class="v">{SITE.location}</span></div>
      {SOCIALS.map((s) => (
        <div class="row"><span class="k">{s.label}</span><a class="v link" href={s.href} target="_blank" rel="noopener noreferrer">[ Visit &gt; ]</a></div>
      ))}
    </aside>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .idx { color: var(--color-faint); display: block; margin-bottom: 1rem; }
  .sl { color: var(--color-accent); }
  .page-h { font-size: clamp(2.5rem, 9vw, 6rem); font-weight: 700; line-height: 0.9; letter-spacing: -0.04em; text-transform: uppercase; }
  .big-mail { display: inline-block; margin-top: 1.5rem; font-size: clamp(1.1rem, 3.4vw, 2.25rem); font-weight: 500; letter-spacing: -0.02em; border-bottom: 2px solid var(--color-line); }
  .big-mail:hover { border-color: var(--color-accent); }

  .grid { display: grid; gap: 3rem; grid-template-columns: 1fr; border-top: 1px solid var(--color-line); }
  .field { display: block; margin-bottom: 1.25rem; }
  .field .k { display: block; color: var(--color-faint); margin-bottom: 0.5rem; }
  .field input, .field textarea { width: 100%; background: transparent; border: 1px solid var(--color-line); border-radius: 0; padding: 0.75rem; font: inherit; color: var(--color-ink); }
  .field input::placeholder, .field textarea::placeholder { color: var(--color-faint); }
  .field input:focus, .field textarea:focus { border-color: var(--color-accent); outline: none; }
  .submit { margin-top: 0.5rem; padding: 0.85rem 1.25rem; border: 1px solid var(--color-ink); background: var(--color-ink); color: var(--color-paper); cursor: pointer; }
  .submit:hover { background: var(--color-accent); border-color: var(--color-accent); }
  .hidden { display: none; }

  .meta .row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--color-line); }
  .meta .k { color: var(--color-faint); }
  .meta .v { color: var(--color-ink); text-align: right; display: inline-flex; align-items: center; gap: 0.4rem; }
  .meta .link:hover { color: var(--color-accent); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #22b070; display: inline-block; }
  @media (min-width: 820px) { .grid { grid-template-columns: 1.3fr 1fr; } }
</style>
