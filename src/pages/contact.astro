---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import MonoLabel from "../components/MonoLabel.astro";
import { SITE, SOCIALS } from "../consts";

const fieldClass =
  "mt-2 w-full rounded-xl border border-line bg-ink-soft px-4 py-3 text-paper placeholder:text-muted-dark focus:border-accent focus:outline-none";
---

<BaseLayout
  title={`Contact — ${SITE.name}`}
  description="Get in touch with Anton Lukovyi — freelance UX/UI designer. Available for new projects."
>
  <Container class="py-16 sm:py-24">
    <MonoLabel>Let's chat!</MonoLabel>
    <h1 class="mt-4 max-w-3xl text-5xl font-medium text-paper sm:text-6xl">
      Have a project in mind? Let's talk.
    </h1>

    <div class="mt-16 grid gap-16 md:grid-cols-2">
      <!-- Форма (працює на Netlify Forms після деплою) -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-6"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div>
          <label for="name" class="font-mono text-xs uppercase tracking-widest text-muted">Name</label>
          <input id="name" name="name" type="text" required class={fieldClass} placeholder="Your name" />
        </div>
        <div>
          <label for="email" class="font-mono text-xs uppercase tracking-widest text-muted">Email</label>
          <input id="email" name="email" type="email" required class={fieldClass} placeholder="you@email.com" />
        </div>
        <div>
          <label for="message" class="font-mono text-xs uppercase tracking-widest text-muted">Message</label>
          <textarea id="message" name="message" rows="5" required class={fieldClass} placeholder="Tell me about your project"></textarea>
        </div>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 font-mono text-sm font-medium uppercase tracking-wide text-accent-ink transition-colors hover:bg-paper"
        >
          Send message
        </button>
      </form>

      <!-- Прямі контакти -->
      <aside class="space-y-10">
        <div>
          <MonoLabel>Email</MonoLabel>
          <a
            href={`mailto:${SITE.email}`}
            class="mt-2 block text-2xl font-medium text-paper transition-colors hover:text-accent"
            >{SITE.email}</a
          >
        </div>
        <div>
          <MonoLabel>Social</MonoLabel>
          <ul class="mt-3 space-y-2">
            {
              SOCIALS.map((s) => (
                <li>
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-paper transition-colors hover:text-accent"
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <MonoLabel>Location</MonoLabel>
          <p class="mt-2 text-paper">{SITE.location}</p>
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>
