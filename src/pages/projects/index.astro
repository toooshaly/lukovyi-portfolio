---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";

const projects = (
  await getCollection("projects", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  )
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`Work — ${SITE.name}`}
  description="Selected UX/UI case studies by Anton Lukovyi — mobile apps, SaaS platforms and product design."
>
  <section class="wrap">
    <span class="mono idx">[ Work ]</span>
    <h1 class="page-h">Selected<br />case studies</h1>
  </section>

  <section class="wrap">
    <ul class="work-list">
      {projects.map((p, i) => (
        <li class="work-row">
          <a href={`/projects/${p.id}`} class="work-link">
            <span class="mono work-num">{String(i + 1).padStart(2, "0")}</span>
            <span class="work-title">{p.data.title}</span>
            <span class="mono work-meta">
              {p.data.year ?? "—"} <span class="sl">/</span> {p.data.category}
              {p.data.status ? <span class="tag"> · {p.data.status}</span> : null}
            </span>
            <span class="mono work-cta">[ Show case &gt; ]</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1.5rem; }
  .idx { color: var(--color-faint); display: block; margin-bottom: 1rem; }
  .sl { color: var(--color-accent); padding: 0 0.1em; }
  .tag { color: var(--color-accent); }
  .page-h { font-size: clamp(2.5rem, 9vw, 6rem); font-weight: 700; line-height: 0.9; letter-spacing: -0.04em; text-transform: uppercase; }

  .work-row { border-top: 1px solid var(--color-line); }
  .work-row:last-child { border-bottom: 1px solid var(--color-line); }
  .work-link { display: grid; grid-template-columns: auto 1fr auto; align-items: baseline; gap: 0.5rem 1.5rem; padding: 1.75rem 0; transition: padding-left 0.2s ease; }
  .work-link:hover { padding-left: 0.75rem; }
  .work-num { color: var(--color-faint); align-self: start; }
  .work-title { grid-column: 2; font-size: clamp(1.75rem, 5vw, 3.5rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1; text-transform: uppercase; }
  .work-link:hover .work-title { color: var(--color-accent); }
  .work-meta { grid-column: 2; color: var(--color-mute); }
  .work-cta { grid-column: 3; grid-row: 1; color: var(--color-accent); align-self: start; white-space: nowrap; }
  @media (max-width: 640px) { .work-cta { display: none; } }
</style>
