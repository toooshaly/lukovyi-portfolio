---
/**
 * Concept Lab — 1:1 з Figma "Portfolio 2.0" (frame Concept lab page, 74:9273).
 * Hero-вордмарк «CONCEPT LAB» (деконструйований) → 3 повноекранні концепт-кейси
 * з девайс-моками, метаданими, номером, назвою-scramble і стрілкою.
 */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import ArrowDiag from "../components/icons/ArrowDiag.astro";
import Plus from "../components/icons/Plus.astro";
import nexusImg from "../assets/lab/nexus-bank.png";
import myfieldImg from "../assets/lab/myfield.png";
import intranetImg from "../assets/lab/intranet.png";

const cases = [
  {
    idx: "001", title: "N_BK", sub: "NEXUS BANK APP", img: nexusImg, overlay: 0.3,
    meta: [["Year", "2024"], ["Industry", "Mobile App"]],
  },
  {
    idx: "002", title: "M_FD", sub: "MYFIELD APP", img: myfieldImg, overlay: 0.55,
    meta: [["Year", "2024"], ["Industry", "Mobile App"]],
  },
  {
    idx: "003", title: "S_SR", sub: "INTRANET WEBSITE", img: intranetImg, overlay: 0.6,
    meta: [
      ["Year", "2023"],
      ["My role", "UX/UI Designer"],
      ["Client", "Statistic Office of Slovak Republic"],
    ],
  },
];
---

<BaseLayout
  title={`Concept Lab — ${SITE.name}`}
  description="Concept work and self-initiated ideas — banking, agri-tech and intranet interfaces explored end to end."
>
  <!-- ================= HERO «CONCEPT LAB» ================= -->
  <section class="lab-hero">
    <div class="lh-wrap">
      <h1 class="lab-word display" aria-label="Concept Lab">
        <span class="lw-row r1">
          <span class="lw-c">C</span>
          <span class="lw-ghost" aria-hidden="true">O</span>
          <span class="lw-ncept">NCEPT</span>
        </span>
        <span class="lw-row r2">
          <span class="lh-tag label" data-typing aria-hidden="true">Concept work/ideas</span>
          <span class="lw-o">O</span>
          <span class="lw-lab">LAB</span>
        </span>
      </h1>
    </div>
  </section>

  <!-- ================= КОНЦЕПТ-КЕЙСИ ================= -->
  <section class="lab-cases" aria-label="Concept cases">
    {cases.map((c) => (
      <article class="lab-case" style={`--ov:${c.overlay}`}>
        <div class="lc-media">
          <Image src={c.img} alt={c.sub} widths={[768, 1200, 1600, 2000]} sizes="100vw" loading="lazy" />
        </div>

        <span class="plus tl" aria-hidden="true"><Plus /></span><span class="plus tr" aria-hidden="true"><Plus /></span>
        <span class="plus bl" aria-hidden="true"><Plus /></span><span class="plus br" aria-hidden="true"><Plus /></span>

        <div class="lc-inner">
          <div class="lc-col">
            <dl class="lc-meta label">
              {c.meta.map(([k, v]) => (
                <div><dt>{k}:</dt><dd>{v}</dd></div>
              ))}
            </dl>

            <div class="lc-title">
              <span class="lc-idx">/ {c.idx}</span>
              <div class="lc-word">
                <span class="lc-name display">{c.title}</span>
                <span class="lc-sub label">{`{ ${c.sub} }`}</span>
              </div>
            </div>
          </div>

          <span class="lc-arrow wc-arrow" aria-hidden="true"><span class="wc-cy"></span><ArrowDiag /></span>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  /* ---------------- HERO ----------------
     Деконструйований вордмарк: O-рядка 2 стоїть під невидимою O рядка 1,
     праві краї NCEPT/LAB вирівняні до одного правого поля. */
  .lab-hero {
    padding: clamp(124px, 14vw, 160px) var(--pad-side) clamp(40px, 6vw, 72px);
  }
  .lh-wrap { position: relative; }

  .lab-word {
    position: relative; margin: 0;
    display: grid; grid-template-rows: 0.8em 0.8em; row-gap: clamp(6px, 0.9vw, 14px);
    font-family: var(--font-display); color: var(--text-primary);
    font-size: min(calc((100vw - var(--pad-side) * 2) / 5.6), 252px);
    line-height: 0.8; white-space: nowrap;
  }
  .lw-row { position: relative; }
  .lw-row > span:not(.lh-tag) { position: absolute; top: 0; line-height: 0.8; }
  .lw-c { left: 5%; }
  .lw-ghost { left: 24%; visibility: hidden; }
  .lw-ncept { right: 7%; }
  .lw-o { left: 24%; }
  .lw-lab { right: 7%; }
  /* Дрібний моно-підпис зліва на рівні другого рядка (не скремблиться — data-typing) */
  .lh-tag {
    position: absolute; left: 0; top: 50%; transform: translateY(-50%);
    font-size: var(--size-sm); color: var(--text-muted); white-space: nowrap;
  }

  @media (max-width: 720px) {
    .lab-hero { padding: 116px 16px 40px; }
    .lab-word { font-size: calc((100vw - var(--pad-side-mobile) * 2) / 5.2); }
    .lh-tag { display: none; }
  }

  /* ---------------- КЕЙСИ ---------------- */
  .lab-cases { display: block; }
  .lab-case {
    position: relative; width: 100%; aspect-ratio: 1440 / 900;
    overflow: hidden; color: var(--text-on-media); background: var(--surface-raised);
  }
  .lc-media { position: absolute; inset: 0; z-index: 0; }
  .lc-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .lab-case::after {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: rgba(0, 0, 0, var(--ov, 0.4));
  }

  .lc-inner {
    position: absolute; inset: 0; z-index: 2;
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: 24px; padding: clamp(24px, 3.34vw, 48px);
  }
  /* ліва колонка на всю висоту: мета зверху, тайтл знизу */
  .lc-col { align-self: stretch; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }

  .lc-meta { display: flex; gap: clamp(24px, 4.44vw, 64px); margin: 0; color: #fff; }
  .lc-meta > div { display: flex; flex-direction: column; gap: 12px; }
  .lc-meta dt { color: rgba(255, 255, 255, 0.7); }
  .lc-meta dd { margin: 0; color: #fff; }

  .lc-title { display: flex; flex-direction: column; gap: clamp(16px, 1.67vw, 24px); }
  .lc-idx { font-family: var(--font-display); color: #fff; font-size: clamp(22px, 2.78vw, 40px); line-height: 0.8; }
  .lc-word { display: flex; align-items: flex-end; flex-wrap: wrap; gap: clamp(20px, 3.34vw, 48px); }
  .lc-name { font-size: clamp(3.75rem, 10.42vw, 150px); line-height: 0.8; letter-spacing: 0; color: #fff; }
  .lc-sub { color: rgba(255, 255, 255, 0.85); }

  /* Стрілка — та сама стилізована ↗ (scramble-поява керується скриптом у BaseLayout) */
  .lc-arrow {
    position: relative; flex-shrink: 0; display: block;
    width: clamp(4rem, 8vw, 115px); height: clamp(4rem, 8vw, 115px);
    color: var(--icon-accent); transition: transform 0.2s ease;
  }
  .lc-arrow :global(svg) { width: 100%; height: 100%; display: block; }
  .lc-arrow .wc-cy {
    position: absolute; inset: 0; display: none; align-items: center; justify-content: center;
    font-family: var(--font-display); font-size: clamp(3rem, 6vw, 88px); line-height: 1; color: currentColor;
  }

  /* Кутові плюси */
  .plus { position: absolute; z-index: 3; width: 16px; height: 16px; pointer-events: none; display: block; color: rgba(255, 255, 255, 0.55); }
  .plus :global(svg) { width: 100%; height: 100%; display: block; }
  .plus.tl { top: 16px; left: 16px; } .plus.tr { top: 16px; right: 16px; }
  .plus.bl { bottom: 16px; left: 16px; } .plus.br { bottom: 16px; right: 16px; }

  @media (max-width: 720px) {
    .lc-inner { padding: 24px; gap: 16px; }
    .lc-meta { gap: 20px; }
    .lc-col { gap: 32px; }
  }
</style>
